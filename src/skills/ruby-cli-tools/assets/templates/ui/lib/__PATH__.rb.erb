# frozen_string_literal: true

require "dry/cli"
require "dry/cli/help"
require "dry/cli/ui"
require "dry/cli/autocomplete/command"
require "zeitwerk"

<%= wrap(gem.modules, "class Error < StandardError; end\n") -%>

loader = Zeitwerk::Loader.<%= gem.parents.empty? ? "for_gem" : "for_gem_extension(::#{gem.parents.join("::")})" %>
loader.inflector.inflect(<%= gem.inflections %>)
loader.setup
