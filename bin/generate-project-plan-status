#!/usr/bin/env ruby
# frozen_string_literal: true

# generate-project-plan-status — fold a `.plans/` tree into one browsable
# Markdown index.
#
# Run it from inside `.plans` (or point it at one with -D) and it walks every
# `NNN-<emoji>-<slug>` folder, decoding the three things the folder name encodes
# — ordinal, status emoji, and human name — then reads `spec.md` for a short
# description and `pull-requests.md` for the PR roll-up.
#
#   cd .plans && generate-project-plan-status              # to stdout
#   generate-project-plan-status -D .plans -o INDEX.md     # to a file
#   generate-project-plan-status list                      # one line per plan
#
# Conventions come from ~/.agents/context/SPECS-AND-PLANS.md and the
# create-plan skill's references/color-mapping.md. Both emoji vocabularies are
# understood, because folders on disk use both.
#
# Document text goes to STDOUT; every spinner, note and box goes to STDERR, so
# the thing composes in a pipe.
#
# © 2026 Konstantin Gredeskoul

require "stringio"

# Silence bundler/inline's install chatter so stdout stays clean for the CLI.
# ensure-restore the real streams: without it a failed gem install would leave
# $stdout/$stderr pointing at StringIO and the error itself would be swallowed.
begin
  real_stdout = $stdout
  real_stderr = $stderr

  unless ENV["PLAN_STATUS_SKIP_BUNDLE"]
    $stdout = StringIO.new
    $stderr = StringIO.new

    require "bundler/inline"

    gemfile(true) do
      # `true` = install missing gems automatically
      source "https://rubygems.org"

      gem "concurrent-ruby"
      gem "pastel"
      gem "tty-spinner"
      gem "tty-box"
      gem "tty-screen"
      gem "tty-spinner"
      gem "dry-cli"
      gem "dry-configurable"
      gem "dry-monads"
    end
  end
ensure
  $stdout = real_stdout
  $stderr = real_stderr
end

require "shellwords"

# dry-cli, tty/*, and pastel arrive through bundler/inline at runtime rather
# than a Gemfile, so they are optional at load time. With
# PLAN_STATUS_SKIP_BUNDLE=1 the file still loads and every pure class below
# (Markdown, Description, PullRequests, Feature, Renderer) can be required and
# exercised without a single gem installed — the CLI wiring is what disappears.
%w[concurrent concurrent/array dry/cli pastel tty/box tty/screen tty/spinner tty/spinner/multi].each do |lib|
  require lib
rescue LoadError
  nil
end

# Everything the generator needs, namespaced so the file stays greppable.
module PlanStatus
  VERSION = "1.0.1"

  # ---------------------------------------------------------------- status --

  # One row of the status vocabulary: the emoji that appears in a folder name
  # and the words that go next to it in the rendered table.
  #
  # @!attribute [r] emoji
  #   @return [String] the emoji exactly as it should be printed
  # @!attribute [r] label
  #   @return [String] the human words, e.g. "In Progress"
  # @!attribute [r] note
  #   @return [String] one-line meaning, used by the optional legend
  Status = Data.define(:emoji, :label, :note) do
    # A status for a folder whose emoji we do not recognise.
    #
    # @param emoji [String, nil] whatever sat between the number and the slug
    # @return [PlanStatus::Status]
    def self.unknown(emoji)
      emoji.to_s.empty? ? new(emoji: "❔", label: "Unstated", note: "no status emoji in the folder name")
                        : new(emoji:, label: "Unknown", note: "emoji not in the status vocabulary")
    end
  end

  # The union of both documented vocabularies. Order matters: it is the order
  # the legend prints in, and it is roughly lifecycle order.
  STATUSES = [
    Status.new(emoji: "⚪️", label: "New",             note: "`spec.md` exists; not planned yet"),
    Status.new(emoji: "⭐️", label: "Ready",           note: "`plan.md` exists and its ready for implementation"),
    Status.new(emoji: "🟡", label: "In Progress",     note: "at least one PR submitted"),
    Status.new(emoji: "🟣", label: "Merged",          note: "PR-level status"),
    Status.new(emoji: "✅", label: "Done",            note: "every PR merged"),
    Status.new(emoji: "⭕️", label: "Blocked",         note: "engineering must decide first — see `blocked.md`"),
    Status.new(emoji: "🅱️", label: "Product Blocked", note: "product must decide first — see `blocked.md`"),
    Status.new(emoji: "⛔️", label: "Rejected",        note: "terminal; see `rejected.md`"),
    Status.new(emoji: "⬜️", label: "Retroactive",     note: "feature is live, but without the spec or a plan."),
    Status.new(emoji: "☢️", label: "Deferred",        note: "deliberately deferred; the trigger is in `spec.md`")
  ].freeze

  # Variation selectors and zero-width joiners make ⚪️ and ⚪ different strings
  # while meaning the same thing to a human. Compare with them removed.
  #
  # @param str [String, nil]
  # @return [String]
  def self.fold_emoji(str) = str.to_s.gsub(/[\u{FE0E}\u{FE0F}\u{200D}]/, "")

  # Index built once; keys are folded so ⚪ and ⚪️ both resolve.
  STATUS_BY_EMOJI = STATUSES.each_with_object({}) { |s, h| h[fold_emoji(s.emoji)] ||= s }.freeze

  # @param emoji [String, nil] the token between the ordinal and the slug
  # @return [PlanStatus::Status] never nil — unknown emoji get a placeholder
  def self.status_for(emoji)
    STATUS_BY_EMOJI[fold_emoji(emoji)] || Status.unknown(emoji)
  end

  # ------------------------------------------------------------- titleizing --

  # Lowercase in the middle of a title, capitalised at the front.
  SMALL_WORDS = %w[a an and as at but by for from in into nor of on or per the to via vs with].freeze

  # Slug words that are really acronyms and should shout.
  ACRONYMS = %w[
    abac ai api aso aws cdn ci cd cli cms cors cpu crm css csv db dns dsl e2e ec2 etl gcp gdpr
    gpu gui html http https iam id ide iam jwt json k8s llm ml mcp mvp npm oauth orm otp pdf
    pii poc pr prs qa rbac rds rest rls rpc rss s3 saas sdk seo soc2 sns spa sql sqs sre ssh
    sso ssl ssr tls tui ts tsx ui ux uuid vpc vpn xml yaml
  ].freeze

  # Words with a house spelling that neither capitalize nor upcase gets right.
  SPECIAL_CASE = {
    "github" => "GitHub", "gitlab" => "GitLab", "graphql" => "GraphQL", "ios" => "iOS",
    "javascript" => "JavaScript", "macos" => "macOS", "nodejs" => "Node.js", "oauth" => "OAuth",
    "openai" => "OpenAI", "postgres" => "PostgreSQL", "postgresql" => "PostgreSQL",
    "typescript" => "TypeScript", "uuidv7" => "UUIDv7", "websocket" => "WebSocket"
  }.freeze

  # Turn a kebab slug into a proper name: `law-as-data` → "Law as Data".
  #
  # @example
  #   PlanStatus.titleize("e2e-cypress-harness")  # => "E2E Cypress Harness"
  #
  # @param slug [String] kebab- or snake-cased identifier
  # @return [String]
  def self.titleize(slug)
    words = slug.to_s.split(/[-_\s.]+/).reject(&:empty?)
    return "" if words.empty?

    words.each_with_index.map do |word, i|
      lower = word.downcase
      case
      when SPECIAL_CASE.key?(lower)                then SPECIAL_CASE[lower]
      when ACRONYMS.include?(lower)                then lower.upcase
      when i.positive? && SMALL_WORDS.include?(lower) then lower
      when lower.match?(/\A\d+\z/)                 then lower
      else                                              lower.sub(/\A./, &:upcase)
      end
    end.join(" ")
  end

  # --------------------------------------------------------------- escaping --

  # @param str [String, nil]
  # @return [String] safe to drop between HTML tags
  def self.escape_html(str)
    str.to_s.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
  end

  # Percent-encode one path segment, byte by byte, so emoji folder names
  # survive being used as an href.
  #
  # @param segment [String] a single path component (no slashes)
  # @return [String]
  def self.encode_segment(segment)
    segment.to_s.b.gsub(/[^A-Za-z0-9\-_.~!$'()*+,;=:@]/n) { |c| format("%%%02X", c.ord) }
           .force_encoding(Encoding::UTF_8)
  end

  # @param path [String] a relative path with `/` separators
  # @return [String] each segment percent-encoded, separators preserved
  def self.encode_path(path)
    path.to_s.split("/", -1).map { |s| encode_segment(s) }.join("/")
  end

  # ---------------------------------------------------------------- inlines --

  # The smallest Markdown-inline → HTML converter that covers what specs
  # actually contain. It exists because GitHub does not render Markdown inside
  # block-level HTML, and the whole feature table is block-level HTML.
  module Inline
    module_function

    # Convert one line (or joined paragraph) of Markdown to HTML.
    #
    # @param text [String] raw Markdown
    # @param base [String, nil] folder the text came from; relative links are
    #   rewritten to hang off it so they still resolve from the index file
    # @return [String] HTML
    def render(text, base: nil)
      code = []
      # Park code spans first: their contents must survive `*` and `[` intact.
      # NUL is the sentinel: no Markdown source can legitimately carry one.
      parked = text.to_s.gsub(/`+([^`]+)`+/) do
        code << ::Regexp.last_match(1)
        "\u0000#{code.size - 1}\u0000"
      end

      out = PlanStatus.escape_html(parked)
      out = out.gsub(/!\[[^\]]*\]\([^)\s]+(?:\s+[^)]*)?\)/, "")                    # images: drop
      out = out.gsub(/\[([^\]]+)\]\(([^)\s]+)(?:\s+[^)]*)?\)/) do                  # links
        %(<a href="#{href(::Regexp.last_match(2), base)}">#{::Regexp.last_match(1)}</a>)
      end
      out = out.gsub(/\*\*([^*]+)\*\*/) { "<strong>#{::Regexp.last_match(1)}</strong>" }
      out = out.gsub(/__([^_]+)__/)     { "<strong>#{::Regexp.last_match(1)}</strong>" }
      out = out.gsub(/~~([^~]+)~~/)     { "<del>#{::Regexp.last_match(1)}</del>" }
      out = out.gsub(/(?<![\w*])\*([^*\n]+)\*(?![\w*])/) { "<em>#{::Regexp.last_match(1)}</em>" }
      out = out.gsub(/(?<![\w_])_([^_\n]+)_(?![\w_])/)   { "<em>#{::Regexp.last_match(1)}</em>" }

      out.gsub(/\u0000(\d+)\u0000/) { "<code>#{PlanStatus.escape_html(code[::Regexp.last_match(1).to_i])}</code>" }
    end

    # Resolve a link target found inside a spec into one that works from the
    # index file, which sits one level above the spec.
    #
    # @param target [String] raw href from the Markdown
    # @param base [String, nil] the feature folder name
    # @return [String]
    def href(target, base)
      return PlanStatus.escape_html(target) if base.nil? || target.match?(%r{\A(?:[a-z][a-z0-9+.-]*:|//|/|#)}i)

      PlanStatus.encode_path("#{base}/#{target}")
    end
  end

  # ------------------------------------------------------------- md parsing --

  # A run of Markdown of a single kind. `:p` carries one joined paragraph;
  # `:ul` / `:ol` carry one string per list item.
  #
  # @!attribute [r] type
  #   @return [Symbol] `:p`, `:ul` or `:ol`
  # @!attribute [r] items
  #   @return [Array<String>] raw Markdown, one entry per paragraph or bullet
  Block = Data.define(:type, :items) do
    # @return [Integer] plain-ish character count, used for the length budget
    def length = items.sum(&:length) + items.size

    # @param base [String, nil] feature folder, for relative-link rewriting
    # @return [String] HTML for this block
    def to_html(base: nil)
      case type
      when :p then "<p>#{Inline.render(items.first, base:)}</p>"
      else         "<#{type}>#{items.map { |i| "<li>#{Inline.render(i, base:)}</li>" }.join}</#{type}>"
      end
    end
  end

  # A heading and the lines beneath it, up to the next heading of any level.
  # Level 0 is the preamble before the first heading.
  #
  # @!attribute [r] level
  #   @return [Integer] 0..6
  # @!attribute [r] title
  #   @return [String, nil] heading text with the `#`s removed
  # @!attribute [r] lines
  #   @return [Array<String>] body lines, headings excluded
  Section = Data.define(:level, :title, :lines)

  # Turns Markdown into sections and blocks. No CommonMark ambitions: it needs
  # to find a "Goal" section and lift three paragraphs out of it, nothing more.
  module Markdown
    module_function

    # Slice a document into sections at every ATX heading, ignoring headings
    # that are really inside a fenced code block.
    #
    # @param text [String] whole file contents
    # @return [Array<PlanStatus::Section>]
    def sections(text)
      out   = [Section.new(level: 0, title: nil, lines: [])]
      fence = nil

      strip_front_matter(text).each_line(chomp: true) do |line|
        if (m = line.match(/\A\s{0,3}(`{3,}|~{3,})/))
          fence = fence.nil? ? m[1][0] : (m[1].start_with?(fence) ? nil : fence)
          out.last.lines << line
          next
        end

        if fence.nil? && (m = line.match(/\A(\#{1,6})\s+(.+?)\s*\#*\s*\z/))
          out << Section.new(level: m[1].length, title: m[2], lines: [])
        else
          out.last.lines << line
        end
      end

      out
    end

    # Drop a leading YAML front-matter block if present.
    #
    # @param text [String]
    # @return [String]
    def strip_front_matter(text)
      text.sub(/\A---\s*\n.*?\n---\s*\n/m, "")
    end

    # Fold body lines into paragraph and list blocks, discarding the furniture
    # (tables, code, callouts, rules, comments) that has no place in a summary.
    #
    # @param lines [Array<String>]
    # @return [Array<PlanStatus::Block>]
    def blocks(lines)
      out   = []
      para  = []
      list  = []
      kind  = nil
      fence = false

      flush = lambda do
        out << Block.new(type: :p, items: [para.join(" ")]) unless para.empty?
        out << Block.new(type: kind, items: list.dup)       unless list.empty?
        para = []
        list = []
        kind = nil
      end

      lines.each do |raw|
        line = raw.rstrip

        if line.match?(/\A\s{0,3}(`{3,}|~{3,})/)
          fence = !fence
          flush.call
          next
        end
        next if fence

        case line
        when /\A\s*\z/                       then flush.call
        when /\A\s{0,3}\|/                   then flush.call                      # table
        when /\A\s{0,3}>/                    then flush.call                      # blockquote / callout
        when /\A\s{0,3}<!--/                 then flush.call                      # comment
        when /\A\s{0,3}(?:[-*_]\s*){3,}\z/   then flush.call                      # thematic break
        when /\A\s{0,3}</                    then flush.call                      # raw HTML
        when /\A(\s*)[-*+]\s+(.*)\z/
          item = ::Regexp.last_match(2)
          out << Block.new(type: :p, items: [para.join(" ")]) unless para.empty?
          para = []
          flush.call if kind == :ol
          kind = :ul
          list << item
        when /\A(\s*)\d+[.)]\s+(.*)\z/
          item = ::Regexp.last_match(2)
          out << Block.new(type: :p, items: [para.join(" ")]) unless para.empty?
          para = []
          flush.call if kind == :ul
          kind = :ol
          list << item
        else
          if list.empty?
            para << line.strip
          else
            list[-1] = "#{list.last} #{line.strip}"   # lazy continuation
          end
        end
      end

      flush.call
      out
    end

    # Split a Markdown table row into stripped cells.
    #
    # @param row [String] a line beginning and usually ending with `|`
    # @return [Array<String>]
    def cells(row)
      row.strip.sub(/\A\|/, "").sub(/\|\z/, "").split(/(?<!\\)\|/).map(&:strip)
    end

    # @param row [String]
    # @return [Boolean] whether the row is a `|---|:--:|` alignment row
    def delimiter_row?(row)
      cells(row).all? { |c| c.match?(/\A:?-{1,}:?\z/) } && !cells(row).empty?
    end

    # Every GFM table in the document, in order.
    #
    # @param text [String]
    # @return [Array<Hash{Symbol => Array}>] `{header: [String], rows: [[String]]}`
    def tables(text)
      lines  = text.each_line(chomp: true).to_a
      tables = []
      i      = 0

      while i < lines.length
        head = lines[i]
        nxt  = lines[i + 1]
        unless head&.strip&.start_with?("|") && nxt&.strip&.start_with?("|") && delimiter_row?(nxt)
          i += 1
          next
        end

        rows = []
        j    = i + 2
        while j < lines.length && lines[j].strip.start_with?("|")
          rows << cells(lines[j])
          j += 1
        end

        tables << { header: cells(head), rows: rows }
        i = j
      end

      tables
    end
  end

  # ------------------------------------------------------------ description --

  # Headings that answer "what is this feature about?", best first.
  # They are matched against a heading stripped of punctuation and section
  # numbering, so "## 0. Context and goal" is tested as "Context and goal".
  # Unambiguous enough to trust at any depth.
  DESCRIPTION_HEADINGS = [
    /\Agoals?\b/i, /\Asummary\b/i, /\Aoverview\b/i, /\Aabstract\b/i, /\Apurpose\b/i,
    /\Aobjectives?\b/i, /\A(?:the )?problem\b/i, /\Amotivation\b/i, /\Abackground\b/i,
    /\A(?:the )?context\b/i, /\Aintro/i
  ].freeze

  # Headings that describe the feature only when they are part of the spec's
  # own top-level skeleton. `### 3.1 What it gives us`, four levels into a
  # section about webhooks, describes the webhooks — not the feature.
  WEAK_DESCRIPTION_HEADINGS = [/\Awhat\b/i, /\Awhy\b/i, /\Ain scope\b/i].freeze

  # A paragraph that is really a metadata strip — `**Depends on:** … **Size:** …`
  METADATA_PARAGRAPH = /\A\*\*[^*]+:\*\*/

  # Reads one spec-ish file and produces the short "what is this" description.
  class Description
    # Files to try, in order, when spec.md is missing.
    CANDIDATES = %w[spec.md plan.md blocked.md blockers.md delayed.md rejected.md aborted.md].freeze

    # @param dir [String] absolute path to the feature folder
    # @param max_blocks [Integer] paragraph/list budget
    # @param max_chars [Integer] character budget; 0 disables it
    def initialize(dir:, max_blocks: 3, max_chars: 1200)
      @dir        = dir
      @max_blocks = max_blocks
      @max_chars  = max_chars
    end

    # @param base [String] the feature folder's basename, for relative links
    # @return [String] HTML, always non-empty
    def to_html(base:)
      blocks = budgeted
      return "<p><em>No specification prose found.</em></p>" if blocks.empty?

      blocks.map { |b| b.to_html(base:) }.join("\n        ")
    end

    private

    # @return [String] absolute path to the feature folder
    attr_reader :dir

    # @return [Integer] how many blocks may be emitted
    attr_reader :max_blocks

    # @return [Integer] how many characters may be emitted; 0 means unlimited
    attr_reader :max_chars

    # @return [Array<PlanStatus::Block>] blocks trimmed to both budgets
    def budgeted
      out   = []
      spent = 0

      candidate_blocks.each do |block|
        break if out.size >= max_blocks

        if max_chars.positive? && spent + block.length > max_chars
          # An over-long first block still has to say something: trim a
          # paragraph at a sentence boundary, take a list whole.
          if out.empty?
            out << (block.type == :p ? Block.new(type: :p, items: [self.class.truncate(block.items.first, max_chars)]) : block)
          end
          break
        end

        out << block
        spent += block.length
      end

      out
    end

    # @return [Array<PlanStatus::Block>] every usable block, unbudgeted
    def candidate_blocks
      source = CANDIDATES.map { |f| File.join(dir, f) }.find { |p| File.file?(p) }
      return [] unless source

      sections = Markdown.sections(File.read(source, encoding: "UTF-8"))
      candidates(sections).each do |lines|
        blocks = usable_blocks(lines)
        return blocks unless blocks.empty?
      end

      []
    end

    # Every body we would accept, best first: a "Goal"-ish section, then the
    # H1's own prose, then the preamble, then — for the many specs that open
    # straight into detail — whatever section first yields real prose.
    #
    # @param sections [Array<PlanStatus::Section>]
    # @return [Array<Array<String>>]
    def candidates(sections)
      ordered = []

      # Top-level headings first, so a stray `### What D8 implies…` deep in a
      # long spec cannot outrank the `## 1. The problem` that opens it.
      ordered.concat(matching(sections, DESCRIPTION_HEADINGS, [2]))
      ordered.concat(matching(sections, WEAK_DESCRIPTION_HEADINGS, [2]).sort)
      ordered.concat(matching(sections, DESCRIPTION_HEADINGS, (3..6).to_a))

      ordered << sections.index { |s| s.level == 1 }
      ordered << sections.index { |s| s.level.zero? }
      ordered.concat((0...sections.length).to_a)

      ordered.compact.uniq.map { |i| body_at(sections, i) }.uniq
    end

    # Indexes of sections whose heading matches one of the patterns, in
    # pattern order — callers that would rather have document order sort them.
    #
    # @param sections [Array<PlanStatus::Section>]
    # @param patterns [Array<Regexp>]
    # @param levels [Array<Integer>] heading depths to consider
    # @return [Array<Integer>]
    def matching(sections, patterns, levels)
      patterns.filter_map do |pattern|
        sections.index do |s|
          levels.include?(s.level) && s.title && self.class.normalize_heading(s.title).match?(pattern)
        end
      end
    end

    # A section's prose. A heading that exists only to introduce subsections
    # has none of its own, so borrow from everything nested beneath it.
    #
    # @param sections [Array<PlanStatus::Section>]
    # @param index [Integer] position of the section in question
    # @return [Array<String>]
    def body_at(sections, index)
      section = sections[index]
      return section.lines if section.lines.any? { |l| !l.strip.empty? }

      sections[(index + 1)..].to_a.take_while { |s| s.level > section.level }.flat_map(&:lines)
    end

    # Blocks worth showing: prose and lists, minus the `**Depends on:** …
    # **Size:** …` metadata strip that opens most specs.
    #
    # @param lines [Array<String>]
    # @return [Array<PlanStatus::Block>]
    def usable_blocks(lines)
      Markdown.blocks(lines).reject do |block|
        block.type == :p && block.items.first.match?(METADATA_PARAGRAPH) &&
          block.items.first.scan(/\*\*[^*]+:\*\*/).size > 1
      end
    end

    # Strip punctuation, emoji and section numbering so that "## 0. Context and
    # goal" and "## Goal" both reduce to something the heading patterns match.
    #
    # @param title [String] raw heading text
    # @return [String]
    def self.normalize_heading(title)
      title.gsub(/[^\p{Alnum}\s]/, " ").sub(/\A\s*\d+(?:\s+\d+)*\s+/, "").squeeze(" ").strip
    end

    # Cut text at the last sentence boundary that fits, then repair any
    # Markdown emphasis the cut left hanging open.
    #
    # @param text [String]
    # @param limit [Integer]
    # @return [String]
    def self.truncate(text, limit)
      return text if text.length <= limit

      window = text[0, limit]
      stop   = window.rindex(/[.!?](?:\s|\z)/)
      cut    = stop ? text[0..stop].strip : "#{window.sub(/\s+\S*\z/, "")}…"

      cut = cut.sub(/\[[^\]]*\z/, "").rstrip
      cut += "`"  if cut.count("`").odd?
      cut += "**" if cut.scan("**").size.odd?
      cut
    end
  end

  # ----------------------------------------------------------- pull requests --

  # One row of a feature's `pull-requests.md`.
  #
  # @!attribute [r] number
  #   @return [String, nil] the PR number as written, without `#`
  # @!attribute [r] title
  #   @return [String] PR title, or a fallback when the row had none
  # @!attribute [r] url
  #   @return [String, nil] link to the PR, when the row carried one
  # @!attribute [r] state
  #   @return [String] normalised state words plus emoji, e.g. "Open 🟡"
  PullRequest = Data.define(:number, :title, :url, :state) do
    # @return [String] one `<li>` for the PR column
    def to_html
      label = number ? "##{number} — #{PlanStatus.escape_html(title)}" : PlanStatus.escape_html(title)
      link  = url ? %(<a href="#{PlanStatus.escape_html(url)}">#{label}</a>) : label
      "<li>#{link} (#{PlanStatus.escape_html(state)})</li>"
    end
  end

  # Extracts the PR roll-up from a feature folder.
  class PullRequests
    # Canonical wording for the states we recognise, with their emoji.
    STATES = [
      [/\bmerged\b/i,             "Merged 🟣"],
      [/\bdraft\b|\bwip\b/i,      "WIP 🟡"],
      [/\bopen\b/i,               "Open 🟡"],
      [/\bclosed\b|\babandoned\b/i, "Closed 🔴"]
    ].freeze

    # @param dir [String] absolute path to the feature folder
    def initialize(dir:)
      @dir = dir
    end

    # @return [Array<PlanStatus::PullRequest>] possibly empty
    def all
      @all ||= parse
    end

    private

    # @return [String] absolute path to the feature folder
    attr_reader :dir

    # @return [Array<PlanStatus::PullRequest>]
    def parse
      path = %w[pull-requests.md pull_requests.md prs.md].map { |f| File.join(dir, f) }.find { |p| File.file?(p) }
      return [] unless path

      text  = File.read(path, encoding: "UTF-8")
      table = pick_table(Markdown.tables(text))
      return fallback(text) unless table

      idx  = columns(table[:header])
      rows = table[:rows].filter_map { |cells| row_to_pr(cells, idx) }
      rows.empty? ? fallback(text) : rows
    end

    # The first table that looks like the canonical PR table.
    #
    # @param tables [Array<Hash>]
    # @return [Hash, nil]
    def pick_table(tables)
      tables.find do |t|
        t[:header].any? { |h| h.match?(/pull\s*request|\bpr\b|^#$|^number$/i) } &&
          t[:rows].any? { |r| r.any? { |c| c.match?(%r{/pull/\d+|/merge_requests/\d+}) } }
      end || tables.find { |t| t[:rows].any? { |r| r.any? { |c| c.match?(%r{/pull/\d+}) } } }
    end

    # Map header text to the three column positions we care about.
    #
    # @param header [Array<String>]
    # @return [Hash{Symbol => Integer, nil}]
    def columns(header)
      {
        number: header.index { |h| h.match?(/number|^#$|^pr$|^pr\s*#/i) },
        title:  header.index { |h| h.match?(/name|title|summary|description|scope/i) },
        state:  header.index { |h| h.match?(/status|state/i) }
      }
    end

    # @param cells [Array<String>] one table row
    # @param idx [Hash{Symbol => Integer, nil}] column positions
    # @return [PlanStatus::PullRequest, nil] nil when the row has no PR in it
    def row_to_pr(cells, idx)
      title_cell = cells[idx[:title] || 1].to_s
      link_cell  = cells.find { |c| c.match?(/\[[^\]]+\]\(https?:[^)]+\)/) } || title_cell
      link       = link_cell.match(/\[([^\]]+)\]\((https?:[^)\s]+)\)/)

      url    = link && link[2]
      title  = link ? link[1] : title_cell.gsub(/[*_`]/, "").strip
      number = cells[idx[:number] || 0].to_s[/\d+/] || url&.[](%r{/(?:pull|merge_requests)/(\d+)}, 1)
      return nil if title.empty? && url.nil?

      PullRequest.new(number:, title: title.empty? ? "Pull request" : title, url:,
                      state: normalize_state(cells[idx[:state] || -1].to_s))
    end

    # When there is no parsable table, scrape bare PR links so the column is
    # not silently empty for a folder that clearly has PRs.
    #
    # @param text [String]
    # @return [Array<PlanStatus::PullRequest>]
    def fallback(text)
      text.scan(%r{https?://\S+?/(?:pull|merge_requests)/(\d+)}).flatten.uniq.map do |num|
        url = text[%r{https?://\S+?/(?:pull|merge_requests)/#{num}\b}]
        PullRequest.new(number: num, title: "Pull request ##{num}", url:, state: "Unknown")
      end
    end

    # @param cell [String] whatever the status column held
    # @return [String] canonical state words plus emoji
    def normalize_state(cell)
      STATES.each { |pattern, label| return label if cell.match?(pattern) }
      stripped = cell.gsub(/[*_`]/, "").strip
      stripped.empty? ? "Unknown" : stripped
    end
  end

  # --------------------------------------------------------------- features --

  # Artifacts in the order the skill lists them; anything else is appended.
  # `blockers.md` and `blocked.md` both appear because SPECS-AND-PLANS.md and
  # the skill's colour map disagree, and both spellings exist on disk.
  ARTIFACT_LABELS = {
    "spec.md" => "Spec", "plan.md" => "Plan", "pull-requests.md" => "Pull Requests",
    "blocked.md" => "Blocked", "blockers.md" => "Blockers", "delayed.md" => "Delayed",
    "rejected.md" => "Rejected", "aborted.md" => "Aborted"
  }.freeze

  # One `NNN-<emoji>-<slug>` folder, fully decoded.
  #
  # @!attribute [r] ordinal
  #   @return [String] the leading number, e.g. "007" or "018.01"
  # @!attribute [r] status
  #   @return [PlanStatus::Status]
  # @!attribute [r] slug
  #   @return [String] the kebab tail of the folder name
  # @!attribute [r] dirname
  #   @return [String] folder basename, exactly as it is on disk
  # @!attribute [r] path
  #   @return [String] absolute path to the folder
  Feature = Data.define(:ordinal, :status, :slug, :dirname, :path) do
    # Decode a folder name, or return nil when it is not a plan folder.
    #
    # @param path [String] absolute path to a candidate directory
    # @return [PlanStatus::Feature, nil]
    def self.parse(path)
      name = File.basename(path)
      # `NNN.MM` is a retroactive plan — a sibling of NNN that arrived after
      # it, not a child of it. See ~/.agents/scripts/plan-number.
      m = name.match(/\A(\d+(?:\.\d+)?)[-_](.*)\z/)
      return nil unless m

      ordinal, rest = m.captures
      head, tail    = rest.split(/[-_]/, 2)

      # A leading segment with no ASCII word character is the status emoji;
      # otherwise the folder simply has no status and it is all slug.
      if tail && !head.empty? && !head.match?(/[A-Za-z0-9]/)
        new(ordinal:, status: PlanStatus.status_for(head), slug: tail, dirname: name, path:)
      else
        new(ordinal:, status: PlanStatus.status_for(nil), slug: rest, dirname: name, path:)
      end
    end

    # @return [String] proper name, e.g. "Law as Data"
    def title = PlanStatus.titleize(slug)

    # Sort position. `to_f` rather than `to_i` so that a retroactive 018.01
    # lands between 018 and 019 rather than tying with 018 — and so that "008"
    # is never read as octal.
    #
    # @return [Float]
    def sort_key = ordinal.to_f

    # Files present in the folder, canonical ones first.
    #
    # @return [Array<Array(String, String)>] pairs of `[label, filename]`
    def artifacts
      present = Dir.children(path).select { |f| File.file?(File.join(path, f)) }.reject { |f| f.start_with?(".") }
      known   = ARTIFACT_LABELS.keys & present
      extra   = (present - known).sort

      known.map { |f| [ARTIFACT_LABELS[f], f] } + extra.map { |f| [f, f] }
    end

    # @return [String] HTML for the "Feature Status" cell
    def status_html
      "#{status.emoji}&nbsp;#{PlanStatus.escape_html(status.label)}"
    end

    # @return [String] the H2 line's text, without the leading `##`
    def heading = "#{ordinal} — #{status.emoji} #{title}"

    # GitHub's slugger: downcase, drop everything that is not alphanumeric,
    # underscore, hyphen or space, then turn each remaining space into a
    # hyphen. Emoji and em dashes vanish, leaving their surrounding spaces.
    #
    # @return [String] the in-document anchor for {#heading}
    def anchor
      heading.downcase.gsub(/[^\p{Alnum}\p{Pc}\- ]/u, "").tr(" ", "-")
    end
  end

  # --------------------------------------------------------------------- ui --

  # Everything the user sees that is not the document itself. All of it goes to
  # STDERR: the document owns STDOUT so that `... | pbcopy` stays clean.
  #
  # Every method degrades to plain text when pastel/tty-box are missing, which
  # is what PLAN_STATUS_SKIP_BUNDLE=1 leaves us with.
  module UI
    module_function

    # @return [Pastel, nil] nil when the gem is unavailable
    def pastel
      return @pastel if defined?(@pastel)

      @pastel = defined?(::Pastel) ? ::Pastel.new(enabled: color?) : nil
    end

    # @return [Boolean] whether STDERR is an interactive terminal
    def tty? = $stderr.tty?

    # @return [Boolean] honours NO_COLOR (https://no-color.org)
    def color? = tty? && !ENV.key?("NO_COLOR")

    # @param text [String]
    # @param styles [Array<Symbol>] pastel style names
    # @return [String] decorated when colour is available, bare otherwise
    def paint(text, *styles)
      pastel ? pastel.decorate(text, *styles) : text
    end

    # @param message [String]
    # @return [void]
    def info(message) = box(:info, message)

    # @param message [String]
    # @return [void]
    def error(message) = box(:error, message)

    # A single unadorned line — used for per-plan notes in serial mode.
    #
    # @param message [String]
    # @return [void]
    def note(message) = $stderr.puts("  #{paint("·", :bright_black)} #{message}")

    # @param message [String]
    # @return [void]
    def warn(message) = $stderr.puts("  #{paint("!", :yellow)} #{message}")

    # @param kind [Symbol] `:info`, `:warn`, `:error` or `:success`
    # @param message [String]
    # @return [void]
    def box(kind, message)
      if defined?(::TTY::Box)
        $stderr.puts(::TTY::Box.public_send(kind, message, enable_color: color?, width: width))
      else
        $stderr.puts(message)
      end
    end

    # @return [Integer] a box width that fits the terminal but stays readable
    def width
      screen = defined?(::TTY::Screen) ? ::TTY::Screen.width : 100
      [[screen - 4, 60].max, 100].min
    end
  end

  # -------------------------------------------------------------- collecting --

  # One fully-read plan folder: the decoded name plus everything the renderer
  # needs, so that reading and rendering stay separable — and so that the
  # reading half can run concurrently.
  #
  # @!attribute [r] feature
  #   @return [PlanStatus::Feature] the decoded folder
  # @!attribute [r] description
  #   @return [String] HTML for the description cell
  # @!attribute [r] pull_requests
  #   @return [Array<PlanStatus::PullRequest>]
  # @!attribute [r] artifacts
  #   @return [Array<Array(String, String)>] `[label, filename]` pairs
  Report = Data.define(:feature, :description, :pull_requests, :artifacts) do
    # @return [String] HTML for the PR cell
    def pull_requests_html
      return "<em>—</em>" if pull_requests.empty?

      "<ul>#{pull_requests.map(&:to_html).join}</ul>"
    end

    # @return [String] HTML for the artifacts cell
    def artifacts_html
      return "<em>empty folder</em>" if artifacts.empty?

      items = artifacts.map do |label, file|
        %(<li><a href="#{PlanStatus.encode_path("#{feature.dirname}/#{file}")}">#{PlanStatus.escape_html(label)}</a></li>)
      end
      "<ul>#{items.join}</ul>"
    end
  end

  # Walks a `.plans` directory and reads every plan folder in it.
  #
  # Reading a folder is three file reads and a lot of regex, and the folders are
  # entirely independent of one another — so with tty-spinner present each one
  # gets its own spinner and its own thread, and the whole tree lands in about
  # as long as its slowest single spec takes.
  class Collector
    # @param dir [String] the `.plans` directory
    # @param max_blocks [Integer] description paragraph budget
    # @param max_chars [Integer] description character budget
    # @param serial [Boolean] read one at a time, no spinners
    # @param quiet [Boolean] suppress the per-plan chatter entirely
    def initialize(dir:, max_blocks: 3, max_chars: 1200, serial: false, quiet: false)
      @dir        = File.expand_path(dir)
      @max_blocks = max_blocks
      @max_chars  = max_chars
      @serial     = serial
      @quiet      = quiet
      # Appended to from inside the spinner threads, so it cannot be a plain
      # Array. Falls back to one when concurrent-ruby is missing, which is only
      # ever the PLAN_STATUS_SKIP_BUNDLE path, and that never spins threads.
      @failures = defined?(::Concurrent::Array) ? ::Concurrent::Array.new : []
    end

    # @return [String] absolute path to the `.plans` directory
    attr_reader :dir

    # @return [Array<String>] descriptions of folders that blew up while reading
    attr_reader :failures

    # @return [Array<PlanStatus::Report>] ordered by plan number
def reports
  @reports ||= begin
    found = features
    collected =
      if found.empty?  then []
      elsif spinners?  then read_with_spinners(found)
      else                  read_serially(found)
      end

    collected.compact.sort_by { |r| [r.feature.sort_key, r.feature.dirname] }
  end
end

    # Subdirectories that do not carry a plan number, for a closing note.
    #
    # @return [Array<String>]
    def skipped
      @skipped ||= directories.reject { |p| Feature.parse(p) }.map { |p| File.basename(p) }
    end

    # The project name: the git repository root's basename, else the parent of
    # `.plans`.
    #
    # @return [String]
    def project_name
      root = `git -C #{dir.shellescape} rev-parse --show-toplevel 2>/dev/null`.strip
      PlanStatus.titleize(File.basename(root.empty? ? File.dirname(dir) : root))
    end

    private

    # @return [Integer] description paragraph budget
    attr_reader :max_blocks

    # @return [Integer] description character budget
    attr_reader :max_chars

    # @return [Boolean] whether the caller asked for one-at-a-time reading
    attr_reader :serial

    # @return [Boolean] whether to stay silent while working
    attr_reader :quiet

    # Spinners need a real terminal and the gem; anything else (a pipe, CI, a
    # `--serial` run) gets the quiet path rather than a screenful of escapes.
    #
    # @return [Boolean]
    def spinners? = !serial && !quiet && UI.tty? && defined?(::TTY::Spinner::Multi)

    # @return [Array<String>] absolute paths of every subdirectory
    def directories
      @directories ||= Dir.children(dir)
                          .map { |c| File.join(dir, c) }
                          .select { |p| File.directory?(p) }
                          .reject { |p| File.basename(p).start_with?(".") }
                          .sort
    end

    # @return [Array<PlanStatus::Feature>]
    def features
      @features ||= directories.filter_map { |p| Feature.parse(p) }
    end

    # @param found [Array<PlanStatus::Feature>]
    # @return [Array<PlanStatus::Report>]
    def read_with_spinners(found)
      results  = defined?(::Concurrent::Array) ? ::Concurrent::Array.new : []
      spinners = ::TTY::Spinner::Multi.new(
        ":spinner #{UI.paint("Reading", :bold, :cyan)} #{found.size} plans from #{UI.paint(dir, :bright_black)}",
        format: :dots, output: $stderr, success_mark: UI.paint("✓", :green), error_mark: UI.paint("✖", :red)
      )

      found.each { |feature| register(spinners, results, feature) }
      spinners.auto_spin
      results.to_a
    end

    # @param spinners [TTY::Spinner::Multi]
    # @param results [Array] thread-safe sink
    # @param feature [PlanStatus::Feature]
    # @return [void]
    def register(spinners, results, feature)
      label = format("%-8s %s", feature.ordinal, feature.title)

      spinners.register("[:spinner] #{feature.status.emoji} #{label}") do |spinner|
        report = build(feature)
        results << report
        spinner.success(UI.paint(summarize(report), :bright_black))
      rescue StandardError => e
        failures << "#{feature.dirname}: #{e.message}"
        spinner.error(UI.paint(e.message, :red))
      end
    end

    # @param found [Array<PlanStatus::Feature>]
    # @return [Array<PlanStatus::Report>]
    def read_serially(found)
      found.map do |feature|
        report = build(feature)
        UI.note("#{feature.status.emoji} #{feature.ordinal}  #{feature.title} — #{summarize(report)}") unless quiet
        report
      rescue StandardError => e
        failures << "#{feature.dirname}: #{e.message}"
        UI.warn("#{feature.dirname}: #{e.message}") unless quiet
        nil
      end
    end

    # @param feature [PlanStatus::Feature]
    # @return [PlanStatus::Report]
    def build(feature)
      Report.new(
        feature:,
        description: Description.new(dir: feature.path, max_blocks:, max_chars:).to_html(base: feature.dirname),
        pull_requests: PullRequests.new(dir: feature.path).all,
        artifacts: feature.artifacts
      )
    end

    # @param report [PlanStatus::Report]
    # @return [String] e.g. "2 PRs, 3 files"
    def summarize(report)
      prs = report.pull_requests.size
      "#{prs.zero? ? "no" : prs} PR#{"s" unless prs == 1}, #{report.artifacts.size} file#{"s" unless report.artifacts.size == 1}"
    end
  end

  # ---------------------------------------------------------------- renderer --

  # Turns collected reports into the Markdown document.
  class Renderer
    # @param reports [Array<PlanStatus::Report>]
    # @param project [String] project name for the H1
    # @param dir [String] the `.plans` directory, for the empty-tree message
    # @param toc [Boolean] include a table of contents
    # @param legend [Boolean] include the status legend
    # @param timestamp [Boolean] include a generated-on line
    def initialize(reports:, project:, dir: ".", toc: false, legend: false, timestamp: false)
      @reports   = reports
      @project   = project
      @dir       = dir
      @toc       = toc
      @legend    = legend
      @timestamp = timestamp
    end

    # @return [String] the whole Markdown document
    def render
      parts = ["# Project #{project}", "", "## Current Specifications and Their Status.", ""]
      parts.concat(["_Generated #{Time.now.strftime("%Y-%m-%d %H:%M")} by `generate-project-plan-status`._", ""]) if timestamp
      parts.concat(legend_lines) if legend
      parts.concat(toc_lines)    if toc

      if reports.empty?
        parts << "_No plan folders found in `#{dir}`._"
      else
        reports.each { |r| parts.concat(feature_lines(r)) }
      end

      "#{parts.join("\n").rstrip}\n"
    end

    private

    # @return [Array<PlanStatus::Report>] the collected plans, in order
    attr_reader :reports

    # @return [String] project name for the H1
    attr_reader :project

    # @return [String] the `.plans` directory
    attr_reader :dir

    # @return [Boolean] whether to print a table of contents
    attr_reader :toc

    # @return [Boolean] whether to print the status legend
    attr_reader :legend

    # @return [Boolean] whether to stamp the generation time
    attr_reader :timestamp

    # @return [Array<String>]
    def legend_lines
      rows = PlanStatus::STATUSES.uniq(&:emoji).map do |status|
        counted = reports.count { |r| PlanStatus.fold_emoji(r.feature.status.emoji) == PlanStatus.fold_emoji(status.emoji) }
        "| #{status.emoji} | **#{status.label}** | #{counted.zero? ? "—" : counted} | #{status.note} |"
      end

      ["### Legend", "", "| Status | Meaning | Count | Notes |", "| :----: | :------ | ----: | :---- |", *rows, ""]
    end

    # @return [Array<String>]
    def toc_lines
      return [] if reports.empty?

      rows = reports.map do |r|
        "1. #{r.feature.status.emoji} [#{r.feature.ordinal} — #{r.feature.title}](##{r.feature.anchor}) — #{r.feature.status.label}"
      end
      ["### Contents", "", *rows, ""]
    end

    # One feature: an H2 and the four-column table. Three of the four columns
    # carry `rowspan="2"`, so the trailing row holds exactly one empty cell.
    #
    # @param report [PlanStatus::Report]
    # @return [Array<String>]
    def feature_lines(report)
      [
        "## #{report.feature.heading}",
        "",
        "<table>",
        "  <thead>",
        "    <tr>",
        "      <th>Feature Status</th>",
        "      <th>PRs &amp; Status</th>",
        "      <th>Feature Short Description</th>",
        "      <th>Artifacts</th>",
        "    </tr>",
        "  </thead>",
        "  <tbody>",
        "    <tr>",
        "      <td>#{report.feature.status_html}</td>",
        "      <td rowspan=\"2\" valign=\"top\">",
        "        #{report.pull_requests_html}",
        "      </td>",
        "      <td rowspan=\"2\" valign=\"top\">",
        "        #{report.description}",
        "      </td>",
        "      <td rowspan=\"2\" valign=\"top\">",
        "        #{report.artifacts_html}",
        "      </td>",
        "    </tr>",
        "    <tr>",
        "      <td></td>",
        "    </tr>",
        "  </tbody>",
        "</table>",
        ""
      ]
    end
  end

  # A one-line-per-plan summary for the terminal, not for a file.
  class Listing
    # @param reports [Array<PlanStatus::Report>]
    def initialize(reports:)
      @reports = reports
    end

    # @return [String] aligned rows, newline-terminated
    def render
      return "" if reports.empty?

      width = reports.map { |r| r.feature.status.label.length }.max
      reports.map { |r| row(r, width) }.join("\n") + "\n"
    end

    private

    # @return [Array<PlanStatus::Report>]
    attr_reader :reports

    # @param report [PlanStatus::Report]
    # @param width [Integer] widest status label, for alignment
    # @return [String]
def row(report, width)
  feature = report.feature
  prs     = report.pull_requests
  open    = prs.count { |pr| pr.state.match?(/\b(?:open|wip|draft)\b/i) }

  # Pad before painting. ANSI escapes are characters as far as format() is
  # concerned, so colouring first silently eats the width of every
  # coloured column and the table stops lining up.
  [
    UI.paint(format("%-7s", feature.ordinal), :bold),
    feature.status.emoji,
    UI.paint(format("%-#{width}s", feature.status.label), :cyan),
    format("%-38s", feature.title),
    UI.paint(pr_summary(prs.size, open), :bright_black)
  ].join("  ").rstrip
end

    # @param total [Integer] pull requests recorded
    # @param open [Integer] of those, not yet merged
    # @return [String]
    def pr_summary(total, open)
      return "—" if total.zero?

      open.zero? ? "#{total} PR#{"s" unless total == 1}" : "#{total} PR#{"s" unless total == 1} (#{open} open)"
    end
  end

  # --------------------------------------------------------------------- cli --

  # The CLI is only wired up when dry-cli actually loaded. Under
  # PLAN_STATUS_SKIP_BUNDLE=1 this block is skipped and the pure logic above
  # remains requirable for testing.
  if defined?(::Dry::CLI)
    # `dry-cli` command registry: `generate` (the default), `list`, `version`.
    module Commands
      extend Dry::CLI::Registry

      # Options every working command shares. Declared through `inherited` so
      # each subclass gets its own copy rather than sharing one mutable set.
      class BaseCommand < Dry::CLI::Command
        def self.inherited(klass)
          super

          klass.option :dir, default: ".", aliases: ["-D"],
                             desc: "The .plans directory"
          klass.option :paragraphs, default: "3", aliases: ["-p"],
                                    desc: "Max description paragraphs per plan"
          klass.option :chars, default: "1200", aliases: ["-c"],
                               desc: "Max description characters per plan (0 = no limit)"
          klass.option :serial, type: :boolean, default: false, aliases: ["-s"],
                                desc: "Read plans one at a time, without spinners"
          klass.option :quiet, type: :boolean, default: false, aliases: ["-q"],
                               desc: "Suppress all progress output on STDERR"
        end

        private

        # Build and run a collector from the parsed flags, or abort loudly.
        #
        # @param options [Hash] the flags dry-cli parsed
        # @return [PlanStatus::Collector]
        def collect(options)
          dir = File.expand_path(options.fetch(:dir, "."))
          unless File.directory?(dir)
            UI.error("Not a directory:\n#{dir}")
            exit 66
          end

          collector = Collector.new(
            dir:,
            max_blocks: options.fetch(:paragraphs, 3).to_i,
            max_chars: options.fetch(:chars, 1200).to_i,
            serial: options.fetch(:serial, false),
            quiet: options.fetch(:quiet, false)
          )
          collector.reports
          collector
        end

        # Closing notes: what was skipped, what failed. Never on STDOUT.
        #
        # @param collector [PlanStatus::Collector]
        # @param options [Hash]
        # @return [Integer] the exit status the command should use
        def report_problems(collector, options)
          return 0 if options.fetch(:quiet, false)

          unless collector.skipped.empty?
            UI.warn("Skipped #{collector.skipped.size} unnumbered #{collector.skipped.size == 1 ? "entry" : "entries"}: " \
                    "#{collector.skipped.join(", ")}")
          end

          return 0 if collector.failures.empty?

          UI.error("#{collector.failures.size} plan(s) could not be read:\n#{collector.failures.join("\n")}")
          1
        end
      end

      # `generate` — the whole point of the script.
      class Generate < BaseCommand
        desc "Render the .plans tree into one Markdown document"

        option :output, aliases: ["-o"], desc: "Write here instead of STDOUT"
        option :name, aliases: ["-n"], desc: "Project name (default: the git repo folder)"
        option :toc, type: :boolean, default: false, aliases: ["-t"], desc: "Prepend a table of contents"
        option :legend, type: :boolean, default: false, aliases: ["-l"], desc: "Prepend the status legend with counts"
        option :timestamp, type: :boolean, default: false, aliases: ["-T"], desc: "Stamp the generation time into the header"

        example [
          "                             # the current .plans, to STDOUT",
          "-D .plans -o .plans/INDEX.md # write the index into the tree",
          "-D .plans --toc --legend     # with contents and a status key"
        ]

        # @param options [Hash] parsed flags
        # @return [void]
        def call(**options)
          collector = collect(options)
          name      = options[:name].to_s.empty? ? collector.project_name : options[:name]

          document = Renderer.new(
            reports: collector.reports, project: name, dir: collector.dir,
            toc: options.fetch(:toc, false), legend: options.fetch(:legend, false),
            timestamp: options.fetch(:timestamp, false)
          ).render

          if (out = options[:output]) && out != "-"
            File.write(out, document)
            UI.info("Wrote #{collector.reports.size} plans to\n#{File.expand_path(out)}") unless options[:quiet]
          else
            $stdout.write(document)
          end

          exit report_problems(collector, options)
        end
      end

      # `list` — the same read, rendered for a human at a terminal.
      class List < BaseCommand
        desc "Print one line per plan: number, status, name, PR count"

        example ["", "-D .plans", "-D .plans --serial"]

        # @param options [Hash] parsed flags
        # @return [void]
        def call(**options)
          collector = collect(options)
          $stdout.write(Listing.new(reports: collector.reports).render)
          exit report_problems(collector, options)
        end
      end

      # `version` — deliberately a bare Dry::CLI::Command: none of the shared
      # options mean anything here.
      class Version < Dry::CLI::Command
        desc "Print the version and exit"

        # @return [void]
        def call(**)
          puts "generate-project-plan-status #{PlanStatus::VERSION}"
        end
      end

      register "generate", Generate, aliases: %w[g gen]
      register "list",     List,     aliases: %w[l ls]
      register "version",  Version,  aliases: %w[--version -V]
    end

    # Names that dry-cli can resolve on its own. Anything else on the front of
    # ARGV means the user went straight for the flags, so `generate` is implied.
    KNOWN_COMMANDS = (%w[generate g gen list l ls version --version -V] + %w[-h --help]).freeze

    # @param argv [Array<String>] the raw ARGV
    # @return [Array<String>] ARGV with the default command filled in
    def self.normalize(argv)
      return ["generate"] if argv.empty?

      KNOWN_COMMANDS.include?(argv.first) ? argv : ["generate", *argv]
    end
  end
end

if defined?(::Dry::CLI) && $PROGRAM_NAME == __FILE__
  Dry::CLI.new(PlanStatus::Commands).call(arguments: PlanStatus.normalize(ARGV))
end
