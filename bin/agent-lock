#!/usr/bin/env bash
# agent-lock.sh — advisory, cross-session file locks for concurrent AI agents.
#
# Several agents routinely run against one checkout at the same time. Git does
# not help: they share a branch and a working tree, so there is no conflict to
# resolve — the last writer simply wins and the loser's work vanishes with no
# error anywhere. This gives them a place to declare intent before writing.
#
# Advisory, not enforced. It works because every agent checks, which is why
# the rule lives in ~/.claude/CLAUDE.md rather than only here.
#
# Usage:
#   agent-lock.sh acquire <path> [intent]   claim a path; exit 1 if held
#   agent-lock.sh release <path>            release a path you hold
#   agent-lock.sh check   <path>            who holds it; exit 1 if held
#   agent-lock.sh list                      every live lock
#   agent-lock.sh mine                      locks held by this agent
#   agent-lock.sh release-all               release every lock this agent holds
#   agent-lock.sh break   <path>            steal a lock; announce it first
#
# Identity comes from $AGENT_ID, else $CLAUDE_SESSION_ID, else the job dir
# name, else a fingerprint of the session this ran in and the directory being
# locked. Set AGENT_ID to something a human can recognise.
#
# © 2026 Konstantin Gredeskoul

set -euo pipefail

LOCK_DIR="${AGENT_LOCK_DIR:-$HOME/.claude/locks}"
STALE_MINUTES="${AGENT_LOCK_STALE_MINUTES:-120}"

# The holder name for a lock on <path>. Every caller passes the path it is
# acting on, because the fingerprint below is per directory.
agent_id() {
  local target="${1:-$PWD}"
  if [[ -n "${AGENT_ID:-}" ]]; then
    printf '%s' "$AGENT_ID"
  elif [[ -n "${CLAUDE_SESSION_ID:-}" ]]; then
    printf '%s' "${CLAUDE_SESSION_ID:0:8}"
  elif [[ -n "${CLAUDE_JOB_DIR:-}" ]]; then
    printf '%s' "$(basename "$CLAUDE_JOB_DIR")"
  else
    printf '%s' "$(fingerprint "$target")"
  fi
}

# The directory a lock is being taken in, absolute, whether or not it exists
# yet — a lock is often claimed for a file about to be created.
#
# @param target the path being locked
abs_dir() {
  local dir
  dir="$(dirname -- "$1")"
  (cd "$dir" 2>/dev/null && pwd) && return 0
  case "$dir" in
    /*) printf '%s' "$dir" ;;
    *) printf '%s/%s' "$PWD" "$dir" ;;
  esac
}

# The session this ran in, as a name that survives leaving and coming back.
#
# Not `$$`: an agent harness runs each command in a shell of its own, so this
# script's own pid is different every invocation and a lock could be acquired
# but never released. Not `$PPID` either, which is that throwaway shell. The
# process that lasts as long as the session is the first ancestor that is not
# a shell — the `claude` or `codex` process driving it, or the terminal a
# human is typing in — so the walk goes up until it finds one.
#
# Its start time goes into the hash along with its pid: pids are recycled, and
# a new session landing on a dead one's number should not inherit its locks.
#
# So does the directory being locked, which is what makes one session working
# in two worktrees of one repository two holders rather than one. The
# directory the lock is *for*, never $PWD: an agent moves around during a run,
# and a holder that renames itself when the process changes directory is the
# same bug as one that renames itself every command.
#
# The name it prints is the ancestor's own — `claude-1f4c8a02` — because a
# holder nobody can recognise is a lock nobody knows who to ask about.
#
# @param target the path being locked
fingerprint() {
  local pid comm hops=0 where

  pid="$PPID"
  while ((hops < 10)); do
    comm="$(basename "$(ps -p "$pid" -o comm= 2>/dev/null || true)")"
    [[ -n "$comm" ]] || break
    # Login shells arrive as `-zsh`, hence the optional leading dash.
    [[ "$comm" =~ ^-?(sh|bash|zsh|ksh|csh|tcsh|fish|dash)$ ]] || break
    local up
    up="$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d ' ' || true)"
    [[ -n "$up" && "$up" -gt 1 ]] || break
    pid="$up"
    hops=$((hops + 1))
  done

  where="$(abs_dir "$1")"

  printf '%s-%s' "${comm:-agent}" \
    "$(printf '%s|%s|%s|%s' "$pid" "$(ps -p "$pid" -o lstart= 2>/dev/null || true)" \
      "$(id -u)" "$where" | digest)"
}

# Whichever of the two every Unix has one of. `cksum` is the last resort: it
# is not a hash anyone should trust, but this needs a stable short string
# rather than a secret.
digest() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -c1-8
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -c1-8
  else
    cksum | tr -d ' ' | cut -c1-8
  fi
}

# A lock name that is stable no matter which directory the agent runs from:
# <repo>--<path relative to repo root>, with separators flattened.
slug() {
  local target="$1" root name rel
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  name="$(basename "$root")"
  rel="$(python3 -c 'import os,sys; print(os.path.relpath(os.path.abspath(sys.argv[1]), sys.argv[2]))' "$target" "$root")"
  printf '%s--%s' "$name" "$(printf '%s' "$rel" | tr '/ ' '__' | tr -cd 'A-Za-z0-9._-')"
}

lockfile() { printf '%s/%s.lock' "$LOCK_DIR" "$(slug "$1")"; }

holder() { [[ -f "$1" ]] && sed -n '1p' "$1" || true; }

is_stale() {
  [[ -n "$(find "$1" -mmin "+${STALE_MINUTES}" 2>/dev/null)" ]]
}

describe() {
  local f="$1"
  printf '  %-28s %s\n' "$(holder "$f")" "$(sed -n '2p' "$f")"
  printf '    claimed %s  intent: %s\n' "$(sed -n '3p' "$f")" "$(sed -n '4p' "$f")"
  is_stale "$f" && printf '    STALE — older than %s minutes\n' "$STALE_MINUTES"
  return 0
}

cmd_acquire() {
  local target="${1:?path required}" intent="${2:-unspecified}"
  local f me payload
  f="$(lockfile "$target")"
  me="$(agent_id "$target")"
  mkdir -p "$LOCK_DIR"

  payload="$me
$(abs_dir "$target")/$(basename "$target")
$(date -u +%Y-%m-%dT%H:%M:%SZ)
$intent"

  if (set -o noclobber; printf '%s\n' "$payload" > "$f") 2>/dev/null; then
    echo "ACQUIRED $target  (holder: $me)"
    return 0
  fi

  # Re-entrant: already ours.
  if [[ "$(holder "$f")" == "$me" ]]; then
    echo "ALREADY YOURS $target"
    return 0
  fi

  echo "HELD by another agent — do not write $target"
  describe "$f"
  if is_stale "$f"; then
    echo "  The lock is stale. Announce in the shared channel, then:"
    echo "    $0 break $target"
  fi
  return 1
}

cmd_release() {
  local target="${1:?path required}" f me
  f="$(lockfile "$target")"
  me="$(agent_id "$target")"
  [[ -f "$f" ]] || { echo "NOT LOCKED $target"; return 0; }
  if [[ "$(holder "$f")" != "$me" ]]; then
    echo "REFUSED — $target is held by $(holder "$f"), not $me"
    return 1
  fi
  rm -f "$f"
  echo "RELEASED $target"
}

cmd_check() {
  local target="${1:?path required}" f
  f="$(lockfile "$target")"
  [[ -f "$f" ]] || { echo "FREE $target"; return 0; }
  echo "HELD $target"
  describe "$f"
  return 1
}

cmd_list() {
  mkdir -p "$LOCK_DIR"
  shopt -s nullglob
  local files=("$LOCK_DIR"/*.lock)
  ((${#files[@]})) || { echo "No locks held."; return 0; }
  echo "Locks held (${#files[@]}):"
  for f in "${files[@]}"; do describe "$f"; done
}

# A holder name is per directory, so "mine" cannot be one string compared
# against every file. Each lock records the path it is for on line 2, which is
# what the name is recomputed from here.
locked_path() { sed -n '2p' "$1"; }

# @param f a lock file
is_mine() { [[ "$(holder "$f")" == "$(agent_id "$(locked_path "$f")")" ]]; }

cmd_mine() {
  mkdir -p "$LOCK_DIR"
  shopt -s nullglob
  local f found=0
  for f in "$LOCK_DIR"/*.lock; do
    is_mine "$f" || continue
    found=1
    describe "$f"
  done
  ((found)) || echo "No locks held by this session."
}

cmd_release_all() {
  mkdir -p "$LOCK_DIR"
  shopt -s nullglob
  local f count=0
  for f in "$LOCK_DIR"/*.lock; do
    is_mine "$f" || continue
    rm -f "$f"
    count=$((count + 1))
  done
  echo "Released $count lock(s) held by this session."
}

cmd_break() {
  local target="${1:?path required}" f
  f="$(lockfile "$target")"
  [[ -f "$f" ]] || { echo "NOT LOCKED $target"; return 0; }
  echo "BREAKING lock on $target, previously:"
  describe "$f"
  rm -f "$f"
  echo "Broken. You are responsible for having announced this first."
}

case "${1:-}" in
  acquire)     shift; cmd_acquire "$@" ;;
  release)     shift; cmd_release "$@" ;;
  check)       shift; cmd_check "$@" ;;
  list)        cmd_list ;;
  mine)        cmd_mine ;;
  release-all) cmd_release_all ;;
  break)       shift; cmd_break "$@" ;;
  *)
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
