#!/usr/bin/env bash
#
# bin/setup — wire ~/.agents into ~/.claude.
#
# The second of the two install steps. bin/install copies a checkout into
# ~/.agents; this links ~/.agents into ~/.claude. Set AGENTS_DIR to read from
# somewhere else.
#
#   bin/setup              # link everything that is not already there
#   bin/setup --dry-run    # say what it would do, touch nothing
#   bin/setup --force      # also repoint symlinks aimed somewhere else
#
# What it does:
#
#   ~/AGENTS.md            -> .agents/config/AGENTS.md
#   ~/.claude/CLAUDE.md    -> ../.agents/config/AGENTS.md
#   ~/.claude/<dir>        -> ../.agents/<dir>          for each shared folder
#
# It is a RECONCILER, not an installer: run it as often as you like. Anything
# already correct is reported and left alone, so the safe response to "did I
# ever link that?" is to run it again. Pulling in external skills and plugins
# is a separate, explicit step — `scripts/install-sources` — precisely
# because that one does network I/O and writes into `skills/`/`plugins/`;
# this script only ever links what is already there.
#
# Two rules it will not break:
#
#   1. It never replaces a real file or directory. ~/.claude holds Claude
#      Code's own state — settings.json, projects/, history — and a setup
#      script that overwrites those is a data-loss bug wearing a helpful hat.
#      Conflicts are reported and skipped.
#
#   2. Links are RELATIVE. ~/.claude/skills/foo -> ../../.agents/skills/foo
#      survives this whole tree being cloned to another machine under a
#      different $HOME, which absolute paths do not.
#
# Where a shared folder already exists in ~/.claude as a real directory — as
# skills/ does, holding one symlink per skill — setup descends one level and
# links the children that are missing. That case is the whole reason this
# script exists: skills added after the initial link were invisible to Claude
# Code because nothing ever linked them.
#
# Descending also sweeps out links whose target this repo no longer has, which
# is what `install-sources` leaves behind when a source stops installing a
# skill. Removing one breaks neither rule above: a dangling link aimed into
# this repo is residue, not anything real.
#
# © 2026 Konstantin Gredeskoul

set -euo pipefail

# What gets linked out is ~/.agents, not the checkout this script happens to
# live in. bin/install copies the checkout there first and flattens it on the
# way, so what is walked below is the same shape it has always been. Kept
# overridable so a run can be pointed at a throwaway tree.
REPO_ROOT="${AGENTS_DIR:-$HOME/.agents}"
# The same tree with every symlink on the way resolved. On a machine still
# set up the old way ~/.agents is itself a link to a checkout, so a link
# written as ../../.agents/skills/foo and one written as
# ../../github/you/agentilda/skills/foo name the same directory, and only the
# physical path says so.
REPO_REAL="$(cd "$REPO_ROOT" 2>/dev/null && pwd -P || printf '%s' "$REPO_ROOT")"
AGENTS_MD="$REPO_ROOT/config/AGENTS.md"
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"

# Folders that belong to the Ruby project rather than to any agent, and have no
# business in ~/.claude. `config` holds AGENTS.md, linked explicitly above, not
# as a shared folder. `src` holds what this repo writes itself, and reaches an
# agent only after `install-sources` folds it into `skills/` — that is what
# gets linked out, not the source it was built from.
SKIP_DIRS=(bin scripts workflow coverage docs tmp vendor node_modules config src skills-temporary)

# Folders that exist as real directories in ~/.claude and hold one link per
# child rather than a single link for the whole folder.
#
# `plugins` belongs here for a reason worth writing down: ~/.claude/plugins is
# Claude's own, holding installed_plugins.json, known_marketplaces.json,
# marketplaces/ and cache/. It is a real directory on any machine Claude has
# ever managed a plugin on, so linking the whole folder would either clobber
# that state or, as it did, be skipped as "already a real directory" and
# quietly link nothing at all. One link per bundle leaves Claude's files where
# they are and puts ours beside them.
DESCEND_DIRS=(skills commands agents plugins)

DRY_RUN=0
FORCE=0
QUIET=0

linked=0
already=0
skipped=0
conflicts=0
pruned=0

# ------------------------------------------------------------------ output --

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  c_reset=$'\033[0m'; c_dim=$'\033[2m'; c_green=$'\033[32m'
  c_yellow=$'\033[33m'; c_red=$'\033[31m'; c_bold=$'\033[1m'
else
  c_reset=""; c_dim=""; c_green=""; c_yellow=""; c_red=""; c_bold=""
fi

say()  { [[ $QUIET -eq 1 ]] || printf '%s\n' "$*" >&2; }
ok()   { [[ $QUIET -eq 1 ]] || printf '  %s✓%s %s\n' "$c_green" "$c_reset" "$*" >&2; }
note() { [[ $QUIET -eq 1 ]] || printf '  %s·%s %s\n' "$c_dim" "$c_reset" "$*" >&2; }
warn() { printf '  %s!%s %s\n' "$c_yellow" "$c_reset" "$*" >&2; }
bad()  { printf '  %s✗%s %s\n' "$c_red" "$c_reset" "$*" >&2; }

usage() {
  sed -n '3,49p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 64
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1; shift ;;
    -f|--force)   FORCE=1;   shift ;;
    -q|--quiet)   QUIET=1;   shift ;;
    -h|--help)    usage ;;
    *) printf 'setup: unknown argument: %s\n\n' "$1" >&2; usage ;;
  esac
done

# ------------------------------------------------------------------- helpers --

# The path a link at $1 should contain in order to point at $HOME-relative $2.
#
# Counts how deep the link sits below $HOME and prefixes that many "../", so
# ~/.claude/skills/foo yields ../../.agents/skills/foo — matching the links
# already in the tree, and surviving a different $HOME on another machine.
relative_target() {
  local dest_dir sub depth prefix i
  dest_dir="$(dirname "$1")"
  sub="${dest_dir#"$HOME"}"
  sub="${sub#/}"

  depth=0
  if [[ -n "$sub" ]]; then
    depth="$(printf '%s' "$sub" | tr '/' '\n' | grep -c . || true)"
  fi

  prefix=""
  for ((i = 0; i < depth; i++)); do prefix="../$prefix"; done
  printf '%s%s\n' "$prefix" "$2"
}

# Create one symlink, refusing to destroy anything real.
#
#   $1 real path under ~/.agents      $2 where the link goes      $3 label
link_one() {
  local source="$1" dest="$2" label="$3" want current
  want="$(relative_target "$dest" "${source#"$HOME"/}")"

  if [[ -L "$dest" ]]; then
    current="$(readlink "$dest")"
    if [[ "$current" == "$want" ]] || [[ "$(cd "$(dirname "$dest")" && cd "$(dirname "$current")" 2>/dev/null && pwd)/$(basename "$current")" == "$source" ]]; then
      already=$((already + 1)); note "$label ${c_dim}already linked${c_reset}"; return 0
    fi

    if [[ $FORCE -eq 1 ]]; then
      [[ $DRY_RUN -eq 1 ]] || { rm "$dest"; ln -s "$want" "$dest"; }
      linked=$((linked + 1)); ok "$label ${c_dim}repointed from $current${c_reset}"; return 0
    fi

    conflicts=$((conflicts + 1))
    warn "$label points at $current — pass --force to repoint it"
    return 0
  fi

  if [[ -e "$dest" ]]; then
    conflicts=$((conflicts + 1))
    bad "$label exists and is not a symlink — left untouched"
    return 0
  fi

  [[ $DRY_RUN -eq 1 ]] || { mkdir -p "$(dirname "$dest")"; ln -s "$want" "$dest"; }
  linked=$((linked + 1)); ok "$label -> $want"
}

# Remove one symlink whose target is gone, if and only if it aimed into this
# repo. The target's own parent is resolved rather than the target itself —
# the target is exactly the thing that no longer exists — so a link left over
# from skills/foo still proves it pointed at REPO_ROOT/skills.
#
#   $1 the suspect link      $2 label
prune_dangling() {
  local stale="$1" label="$2" target parent

  [[ -L "$stale" && ! -e "$stale" ]] || return 0

  target="$(readlink "$stale")"
  parent="$(cd "$(dirname "$stale")" && cd "$(dirname "$target")" 2>/dev/null && pwd -P || true)"
  [[ -n "$parent" && ( "$parent" == "$REPO_REAL" || "$parent" == "$REPO_REAL"/* ) ]] || {
    conflicts=$((conflicts + 1))
    warn "$label is broken but points outside this repo ($target) — left alone"
    return 0
  }

  [[ $DRY_RUN -eq 1 ]] || rm "$stale"
  pruned=$((pruned + 1)); ok "$label ${c_dim}removed, $target is gone from this repo${c_reset}"
}

in_list() {
  local needle="$1"; shift
  local item
  for item in "$@"; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

# ---------------------------------------------------------------------- run --

say ""
say "${c_bold}Linking ${REPO_ROOT} into ${CLAUDE_DIR}${c_reset}"
[[ $DRY_RUN -eq 1 ]] && say "${c_yellow}dry run — nothing will be written${c_reset}"
say ""

# Missing is fatal for a real run and expected for a previewed one: under
# --dry-run bin/install has not created it yet, and refusing to preview the
# second step because the first was also only previewed helps nobody.
if [[ ! -d "$REPO_ROOT" ]]; then
  [[ $DRY_RUN -eq 1 ]] || { bad "$REPO_ROOT does not exist — bin/install puts it there"; exit 66; }
  note "$REPO_ROOT does not exist yet — bin/install creates it"
  say ""
  exit 0
fi
[[ -f "$AGENTS_MD" ]] || { bad "no AGENTS.md in $(dirname "$AGENTS_MD")"; exit 66; }
mkdir -p "$CLAUDE_DIR"

say "${c_bold}Instructions${c_reset}"
link_one "$AGENTS_MD" "$HOME/AGENTS.md"          "~/AGENTS.md"
link_one "$AGENTS_MD" "$CLAUDE_DIR/CLAUDE.md"    "~/.claude/CLAUDE.md"

say ""
say "${c_bold}Shared folders${c_reset}"

for path in "$REPO_ROOT"/*/; do
  name="$(basename "$path")"

  if in_list "$name" "${SKIP_DIRS[@]}"; then
    skipped=$((skipped + 1)); note "$name ${c_dim}project-internal, not shared${c_reset}"; continue
  fi

  dest="$CLAUDE_DIR/$name"

  # A real directory already there: link its children instead of replacing it.
  if [[ -d "$dest" && ! -L "$dest" ]]; then
    if in_list "$name" "${DESCEND_DIRS[@]}"; then
      say "  ${c_dim}$name is a real directory — linking its children${c_reset}"
      for child in "$path"*; do
        [[ -e "$child" ]] || continue
        child_name="$(basename "$child")"
        link_one "${child%/}" "$dest/$child_name" "  $name/$child_name"
      done
      for existing in "$dest"/*; do
        prune_dangling "$existing" "  $name/$(basename "$existing")"
      done
    else
      skipped=$((skipped + 1)); note "$name ${c_dim}already a real directory in ~/.claude${c_reset}"
    fi
    continue
  fi

  link_one "${path%/}" "$dest" "~/.claude/$name"
done

# --------------------------------------------------------------- summary ----

say ""
printf '  %slinked %d   already %d   skipped %d   pruned %d   conflicts %d%s\n' \
  "$c_bold" "$linked" "$already" "$skipped" "$pruned" "$conflicts" "$c_reset" >&2

if [[ $conflicts -gt 0 ]]; then
  say ""
  say "  ${c_yellow}Some targets were left alone. Nothing real is ever overwritten;${c_reset}"
  say "  ${c_yellow}move them aside yourself, or re-run with --force for wrong symlinks.${c_reset}"
fi

say ""
say "  ${c_dim}New machine, or skills feeling stale? scripts/install-sources -f${c_reset}"

say ""


exit 0
