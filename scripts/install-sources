#!/usr/bin/env ruby
# frozen_string_literal: true

# install-sources — pull external skills and plugins into this repo.
#
#   scripts/install-sources              # clone what's missing, update the rest
#   scripts/install-sources --dry-run    # say what it would do, touch nothing
#   scripts/install-sources -f           # wipe .sources and re-clone everything fresh
#   scripts/install-sources list         # what's configured, and what's installed
#
# Reads configuration.yml, which a first run seeds from the committed
# configuration.example.yml beside it. Each source is cloned into `.sources/<name>`
# (gitignored — kept only so a plain `install-sources` can `git pull` instead
# of re-cloning) and installed into `skills/` or `plugins/` — both also
# gitignored, both fully regenerable from configuration.yml plus `src/skills/`,
# which this script always symlinks in too.
#
# A source that carries more skills than you want can narrow itself with
# `include_skills: /re/` or `exclude_skills: /re/` in configuration.yml, one or the
# other, never both. Either is matched against the name each skill would
# install as, so what you filter on is what you see in `skills/`.
#
# A `type: command` source has no repository. It runs its `install:` command
# with the working directory inside `.sources/<name>` and then installs the
# skills and plugin bundles that turned up there, which keeps a command
# installer inside the same manifest, filter and prune that everything else
# here relies on. Do not pass a global flag such as `npx skills add -g`: that
# writes to ~/.claude/skills, where this script has no record of it and no
# filter that reaches it.
#
# Deliberately dependency-free: this has to run on a machine that has not run
# `bundle install` yet, because it is part of what makes that machine usable.
#
# © 2026 Konstantin Gredeskoul

require "yaml"
require "fileutils"
require "json"
require "open3"
require "shellwords"

# Overridable so the suite can point a whole run at a throwaway tree. Nothing
# else sets it; in normal use this is the repo the script lives in.
#
# Resolved through any symlinks on the way, because the manifest records
# absolute paths and this tree is reachable by more than one of them:
# ~/.agents is itself a link to wherever the checkout lives. Two runs that
# disagreed about the spelling would each read the other's links as stale.
ROOT = File.realpath(ENV.fetch("INSTALL_SOURCES_ROOT") { File.expand_path("..", __dir__) })
# What the installer reads, and the committed file it is seeded from. The
# read one is per-machine and git-ignored: which skills and which agents a
# machine should have is a property of that machine, not of this repo.
CONFIG_FILE = File.join(ROOT, "configuration.yml")
EXAMPLE_FILE = File.join(ROOT, "configuration.example.yml")
STAGING_DIR = File.join(ROOT, ".sources")
SKILLS_DIR = File.join(ROOT, "skills")
PLUGINS_DIR = File.join(ROOT, "plugins")
SRC_SKILLS_DIR = File.join(ROOT, "src", "skills")
MANIFEST_FILE = File.join(STAGING_DIR, "manifest.json")

# Every dest this run installs, owner by owner, filled in by `link` before it
# has done any writing so that a dry run previews the same prune a real one
# would perform.
INSTALLED = {}

# The same dest, and what it was pointed at, so that two things trying to
# install under one name can be told apart from one thing installed twice.
CLAIMED = {}

# ---------------------------------------------------------------- output --

COLOR = $stderr.tty? && !ENV.key?("NO_COLOR")
def paint(text, code) = COLOR ? "\e[#{code}m#{text}\e[0m" : text.to_s

# standard:disable Style/StderrPuts -- Kernel#warn is a no-op under RUBYOPT=-W0,
# which is common in CI and agent harnesses; writing $stderr directly is not.
def out(msg) = $stderr.puts(msg)
# standard:enable Style/StderrPuts
def ok(msg) = out("  #{paint("✓", 32)} #{msg}")
def note(msg) = out("  #{paint("·", 2)} #{msg}")
def bad(msg) = out("  #{paint("✗", 31)} #{msg}")
def warn_(msg) = out("  #{paint("!", 33)} #{msg}")
def say(msg) = out(msg)

# ----------------------------------------------------------------- source --

# A configuration.yml this script will not guess its way past: two filters on one
# source, or a regular expression that does not compile. Both are typos whose
# quiet outcome, nothing installed or everything installed, looks enough like
# success to go unnoticed, so they stop the run instead of degrading it.
class ConfigError < StandardError; end

# `/re/` and `/re/i` both work as a filter value, and so does a bare `re`. The
# slashes are there so the value reads as a regular expression to a human, not
# because Ruby needs them in order to parse one.
SLASHED = %r{\A/(?<body>.*)/(?<flags>[imx]*)\z}m
SLASHED_FLAGS = {"i" => Regexp::IGNORECASE, "m" => Regexp::MULTILINE, "x" => Regexp::EXTENDED}.freeze

# The two things a source can hand over. Both by default: a command that
# writes a plugin bundle and some loose skills is handing over both, and
# silently taking half would be a surprise.
ADOPTABLE = %w[skills plugins].freeze

# Types for which `adopt:` is a real question. A `type: skills` source has
# nothing but skills to give.
ADOPTERS = %w[command plugin].freeze

# Where a command's output is looked for, relative to the directory it ran in,
# in the order they are tried.
#
# `npx skills add` without `-g` writes `./.claude/skills/<name>`; Braintrust's
# `bt setup skills` writes `./.agents/skills/<name>` even when told
# `--agent claude`. Two installers, two roots, so this is a list rather than
# the one convention an earlier comment here claimed it was. `path:` overrides
# it for a command that does something else again.
COMMAND_ROOTS = %w[.claude .agents].freeze

# Every key each kind of entry may carry. A key outside these lists is a typo,
# and a typo silently ignored is the quiet failure this whole script is built
# against: `include_skils` on a source does not narrow anything, and without
# this the run installs everything and reports success.
#
# configuration.schema.json states the same rule for editors and for the
# suite, as `unevaluatedProperties: false`. It cannot be used here — this
# script has to run before there is a bundle to load a validator from — so
# the two are kept honest by a spec that feeds the same bad configurations to
# both and requires them to agree.
TOP_LEVEL_KEYS = %w[agents sources].freeze
TYPES = %w[skills plugin command].freeze
AGENT_KEYS = %w[name installer].freeze
SOURCE_KEYS = %w[name type repo path install adopt
  include_skills exclude_skills include_plugins exclude_plugins
  agents exclude_agents].freeze

# @param hash [Hash] the entry as written
# @param allowed [Array<String>] every key it may carry
# @param what [String] how to name it in the refusal
# @return [void]
def reject_unknown_keys(hash, allowed, what)
  unknown = hash.keys.map(&:to_s) - allowed
  return if unknown.empty?

  near = unknown.filter_map { |key|
    match = allowed.min_by { |k| levenshtein(key, k) }
    "#{key} (did you mean #{match}?)" if match && levenshtein(key, match) <= 3
  }
  named = near.empty? ? unknown.join(", ") : near.join(", ")
  raise ConfigError, "#{what}: #{named}. Known keys: #{allowed.join(", ")}"
end

# Small enough to write out rather than depend on: this script loads nothing.
#
# @return [Integer]
def levenshtein(a, b)
  rows = (0..b.length).to_a
  a.each_char.with_index do |ch, i|
    previous = rows
    rows = [i + 1]
    b.each_char.with_index do |other, j|
      rows << [rows[j] + 1, previous[j + 1] + 1, previous[j] + ((ch == other) ? 0 : 1)].min
    end
  end
  rows.last
end

# One entry from configuration.yml.
#
# `include_skills` and `exclude_skills` narrow which of the skills a source
# carries actually reach `skills/`. At most one of the two: a source that both
# allows and denies is a question with no defensible answer.
#
# `agents` and `exclude_agents` say which coding agents a source is for, and
# follow the same one-or-the-other rule for the same reason. Absent means
# portable, which is the common case and this repo's whole premise; the
# vendor-locked source is the exception that has to say so.
Source = Struct.new(:name, :type, :repo, :path, :install, :adopt,
  :include_skills, :exclude_skills, :include_plugins, :exclude_plugins,
  :agents, :exclude_agents) do
  def self.from_yaml(hash)
    name = hash.fetch("name")
    reject_unknown_keys(hash, SOURCE_KEYS, "#{name}: keys nothing reads")
    type = hash.fetch("type")
    raise ConfigError, "#{name}: type: #{type.inspect} — expected #{TYPES.join(", ")}" unless TYPES.include?(type)
    skills = pair(hash, name, "skills")
    plugins = pair(hash, name, "plugins")

    if plugins.any? && !ADOPTERS.include?(type)
      raise ConfigError, "#{name}: include_plugins and exclude_plugins mean nothing on a type: #{type} source, " \
                         "which installs no plugin bundles"
    end

    targeting = names(hash, name, "agents")

    new(name:, type:, repo: origin(hash, name, type), path: hash["path"],
      install: command_for(hash, name, type), adopt: adoption(hash["adopt"], name, type),
      include_skills: skills[:include], exclude_skills: skills[:exclude],
      include_plugins: plugins[:include], exclude_plugins: plugins[:exclude],
      agents: targeting[:include], exclude_agents: targeting[:exclude])
  end

  # One `include_<kind>`/`exclude_<kind>` pair, compiled and checked.
  #
  # A source that both allows and denies the same kind is a question with no
  # defensible answer, so the run stops rather than picking one.
  #
  # @param hash [Hash] the raw YAML entry
  # @param name [String]
  # @param kind [String] "skills" or "plugins"
  # @return [Hash{Symbol => Regexp, nil}] with an `any?` of false when neither is set
  def self.pair(hash, name, kind)
    include_re = compile(hash["include_#{kind}"], name, "include_#{kind}")
    exclude_re = compile(hash["exclude_#{kind}"], name, "exclude_#{kind}")

    if include_re && exclude_re
      raise ConfigError, "#{name}: include_#{kind} and exclude_#{kind} are both set; " \
                         "a source may use one or the other"
    end

    filters = {include: include_re, exclude: exclude_re}
    filters.define_singleton_method(:any?) { values.any? }
    filters
  end

  # `agents:` and `exclude_agents:` as lists of names, checked the same way
  # the regular-expression pairs are.
  #
  # A list rather than a pattern because these are names from a fixed, short,
  # declared set, and a typo in one should be caught by the run that reads it
  # rather than quietly matching nothing.
  #
  # @param hash [Hash] the raw YAML entry
  # @param name [String]
  # @param key [String] "agents"
  # @return [Hash{Symbol => Array<String>, nil}]
  def self.names(hash, name, key)
    include_list = list(hash[key], name, key)
    exclude_list = list(hash["exclude_#{key}"], name, "exclude_#{key}")

    if include_list && exclude_list
      raise ConfigError, "#{name}: #{key} and exclude_#{key} are both set; " \
                         "a source may use one or the other"
    end

    {include: include_list, exclude: exclude_list}
  end

  # @return [Array<String>, nil]
  def self.list(value, name, key)
    return nil if value.nil?
    raise ConfigError, "#{name}: #{key} must be a list of names, got #{value.inspect}" unless value.is_a?(Array)

    value.map do |entry|
      raise ConfigError, "#{name}: #{key} must be a list of names, got #{entry.inspect}" unless entry.is_a?(String)
      raise ConfigError, "#{name}: #{key} has an empty name in it" if entry.strip.empty?

      entry.strip
    end.tap { |l| raise ConfigError, "#{name}: #{key} is empty — leave it out to mean every agent" if l.empty? }
  end

  # Whether anything on this machine would ever read what this source
  # installs.
  #
  # @param known [Array<String>] agents installed, or listed to be
  # @return [Boolean]
  def for_any?(known)
    return agents.intersect?(known) if agents
    return (known - exclude_agents).any? if exclude_agents

    true
  end

  # @return [String, nil] why it was skipped, for the log
  def targeting_note
    return "for #{agents.join(", ")}, none of which this machine has" if agents
    return "excluded from #{exclude_agents.join(", ")}, which is every agent here" if exclude_agents

    nil
  end

  # A source is fetched by cloning a repository or by running a command, and
  # never by both. Naming the wrong one for the type is a typo whose quiet
  # outcome is a key nobody reads, so it stops the run.
  #
  # @param hash [Hash] the raw YAML entry
  # @param name [String]
  # @param type [String]
  # @return [String, nil]
  def self.origin(hash, name, type)
    return hash.fetch("repo") unless type == "command"
    raise ConfigError, "#{name}: a type: command source is fetched by `install:`, so `repo:` would be ignored" if hash["repo"]

    nil
  end

  # @param hash [Hash]
  # @param name [String]
  # @param type [String]
  # @return [String, nil]
  def self.command_for(hash, name, type)
    value = hash["install"]
    unless type == "command"
      raise ConfigError, "#{name}: `install:` only runs on a type: command source, and this is type: #{type}" if value

      return nil
    end
    raise ConfigError, "#{name}: type: command needs an `install:` command to run" if value.to_s.strip.empty?
    raise ConfigError, "#{name}: install: must be a command line, got #{value.inspect}" unless value.is_a?(String)

    value
  end

  # What a source is allowed to contribute. One command can write both a
  # plugin bundle and loose skills, and wanting only one half of that is a
  # normal thing to want, so it is a list rather than a type.
  #
  # @param value [String, Array<String>, nil]
  # @param name [String]
  # @param type [String]
  # @return [Array<String>]
  def self.adoption(value, name, type)
    return ADOPTABLE.dup if value.nil?

    unless ADOPTERS.include?(type)
      raise ConfigError, "#{name}: `adopt:` means nothing on a type: #{type} source, which only ever installs skills"
    end

    list = Array(value).map(&:to_s)
    unknown = list - ADOPTABLE
    raise ConfigError, "#{name}: adopt: #{unknown.join(", ")} — expected #{ADOPTABLE.join(" or ")}" unless unknown.empty?
    raise ConfigError, "#{name}: adopt: is empty — delete the source instead of asking it for nothing" if list.empty?

    list
  end

  # @param value [String, nil] the raw YAML value
  # @param name [String] source name, for the failure message
  # @param key [String] which of the two keys this is, for the failure message
  # @return [Regexp, nil]
  def self.compile(value, name, key)
    return nil if value.nil?
    raise ConfigError, "#{name}: #{key} must be a string such as /foo|bar/, got #{value.inspect}" unless value.is_a?(String)

    match = SLASHED.match(value)
    options = (match ? match[:flags] : "").chars.sum { |flag| SLASHED_FLAGS.fetch(flag) }
    Regexp.new(match ? match[:body] : value, options)
  rescue RegexpError => e
    raise ConfigError, "#{name}: #{key} is not a valid regular expression: #{e.message}"
  end

  # @return [Boolean]
  def command? = type == "command"

  # @param what [String] "skills" or "plugins"
  # @return [Boolean]
  def adopts?(what) = (adopt || ADOPTABLE).include?(what.to_s)

  # @return [Array<String>] the command, split into argv. Split rather than
  #   handed to a shell: a command line pasted out of a README should run as
  #   the words it appears to be, without a stray quote or `$HOME` meaning
  #   something.
  def argv = Shellwords.split(install.to_s)

  # @return [String] where this source is cloned to, or runs its command in
  def staging_dir = File.join(STAGING_DIR, name)

  # @return [String] the directory inside the clone this source actually installs from
  def content_dir
    return File.join(staging_dir, path) if path
    return staging_dir unless command?

    # Whichever root the command actually wrote to. The first is the fallback
    # when it wrote neither, so a message about what is missing names something.
    candidates = COMMAND_ROOTS.map { |root| File.join(staging_dir, root) }
    candidates.find { |dir| File.directory?(dir) } || candidates.first
  end

  # @return [String] where this source's loose skills are
  def skills_root = command? ? File.join(content_dir, "skills") : content_dir

  # @return [String] where this source's plugin bundles are
  def plugins_root = File.join(content_dir, "plugins")

  # Matched against the name the thing would install as, `skills/<name>` or
  # `plugins/<name>`, and not against its path inside the source. A category
  # tree is one source's filing decision; the installed name is the thing you
  # go looking for, so it is the thing you filter on.
  #
  # @param kind [String] "skills" or "plugins"
  # @param installed_name [String]
  # @return [Boolean]
  def wants?(kind, installed_name)
    include_re, exclude_re = filters_for(kind)
    return include_re.match?(installed_name) if include_re
    return !exclude_re.match?(installed_name) if exclude_re

    true
  end

  # @param kind [String]
  # @return [Array(Regexp, Regexp)] the include and exclude for that kind
  def filters_for(kind)
    (kind.to_s == "plugins") ? [include_plugins, exclude_plugins] : [include_skills, exclude_skills]
  end

  # @param kind [String] "skills" or "plugins"
  # @return [String, nil] how this source's filter for that kind reads in the output
  def filter_summary(kind = "skills")
    include_re, exclude_re = filters_for(kind)
    return "include_#{kind} /#{include_re.source}/" if include_re
    return "exclude_#{kind} /#{exclude_re.source}/" if exclude_re

    nil
  end

  # @return [Array<String>] every filter this source carries, for the listing
  def filter_summaries = %w[skills plugins].filter_map { |kind| filter_summary(kind) }

  # @return [String, nil] said only when it is not the default, since "adopt
  #   whatever you find" is what every source without the key does
  def adopt_summary
    return nil if adopt.nil? || adopt.sort == ADOPTABLE.sort

    "adopt #{adopt.join(", ")}"
  end
end

def config
  return {} unless File.file?(CONFIG_FILE)

  (YAML.safe_load_file(CONFIG_FILE) || {}).tap do |c|
    reject_unknown_keys(c, TOP_LEVEL_KEYS, "keys nothing reads at the top level")

    # Both blocks, whichever one this run is about. A misspelled key is wrong
    # the moment it is written, and `list` reporting the sources cleanly while
    # `agents` would have refused the same file is a way to believe a typo is
    # fine.
    Array(c["agents"]).each { |a| reject_unknown_keys(a, AGENT_KEYS, "#{a["name"]}: keys nothing reads") if a.is_a?(Hash) }
    Array(c["sources"]).each { |x| reject_unknown_keys(x, SOURCE_KEYS, "#{x["name"]}: keys nothing reads") if x.is_a?(Hash) }
  end
end

def load_sources = (config["sources"] || []).map { |h| Source.from_yaml(h) }

# A first run has nothing to read. Seeding the example across is the easy
# half; the hard half is that a configuration nobody has looked at should
# not silently become what a machine installs. So the copy always happens
# and the install only continues if somebody said it should.
#
# Without a terminal there is nobody to ask, and guessing "yes" would
# install a stranger's list of skills unattended. The seed is reported and
# the run stops, which a second run turns into an ordinary install.
#
# @return [Boolean] whether the caller should go on and install
def ensure_configuration
  return true if File.file?(CONFIG_FILE)

  unless File.file?(EXAMPLE_FILE)
    bad("no configuration.yml, and no configuration.example.yml to seed one from")
    exit 78
  end

  FileUtils.cp(EXAMPLE_FILE, CONFIG_FILE)
  ok("seeded configuration.yml from configuration.example.yml")

  unless $stdin.tty?
    note("nobody here to ask, so nothing installed — read it, then run again")
    return false
  end

  $stderr.print "  install what it lists, as it stands? [y/N] "
  return true if %w[y yes].include?($stdin.gets.to_s.strip.downcase)

  editor = ENV["EDITOR"] || ENV["VISUAL"]
  if editor
    note("opening it in #{editor} — run again when you are happy with it")
    system(*Shellwords.split(editor), CONFIG_FILE)
  else
    note("edit #{CONFIG_FILE.sub("#{ROOT}/", "")} and run again")
  end
  false
end

def load_manifest
  return {} unless File.file?(MANIFEST_FILE)

  JSON.parse(File.read(MANIFEST_FILE))
rescue JSON::ParserError
  {}
end

def save_manifest(manifest)
  FileUtils.mkdir_p(STAGING_DIR)
  File.write(MANIFEST_FILE, JSON.pretty_generate(manifest))
end

# ------------------------------------------------------------------- git --

# @param dir [String]
# @return [Boolean]
def repo?(dir) = File.directory?(File.join(dir, ".git"))

# @param args [Array<String>] argv after `git`
# @param name [String] source name, for the failure message
# @param verb [String] "pull" or "clone", for the failure message
# @return [Boolean]
def run_git(*, name:, verb:)
  _out, err, status = Open3.capture3("git", *)
  bad("#{name}: git #{verb} failed — #{err.lines.first&.strip}") unless status.success?
  status.success?
end

# @param source [Source]
# @param dry_run [Boolean]
# @return [Boolean] whether the clone is present and current
def clone_or_update(source, dry_run:)
  if repo?(source.staging_dir)
    note("#{source.name}: updating #{source.staging_dir.sub("#{ROOT}/", "")}")
    return true if dry_run

    run_git("-C", source.staging_dir, "pull", "--ff-only", "--quiet", name: source.name, verb: "pull")
  else
    note("#{source.name}: cloning #{source.repo}")
    return true if dry_run

    FileUtils.mkdir_p(File.dirname(source.staging_dir))
    run_git("clone", "--quiet", source.repo, source.staging_dir, name: source.name, verb: "clone")
  end
end

# A command source is fetched by running its command rather than by cloning.
#
# It runs once. `npx` re-downloads its package on every invocation and
# `install-sources` is a script people run several times a day, so a source
# whose output is already sitting in `.sources` is left alone. `-f` wipes
# `.sources` before any of this happens, which is what makes it the way to run
# the command again.
#
# The command runs with its working directory inside `.sources/<name>`, which
# is the whole reason this stays inside the model the rest of the script is
# built on. `npx skills add … -g` would write into `~/.claude/skills` instead,
# where there is no manifest entry to record it, no filter to narrow it and no
# prune to take it back when you delete the line from configuration.yml.
#
# @param source [Source]
# @param dry_run [Boolean]
# @return [Boolean] whether the output is there to install from
def run_install(source, dry_run:)
  if File.directory?(source.content_dir) && !Dir.empty?(source.content_dir)
    note("#{source.name}: already installed — `-f` runs it again")
    return true
  end

  note("#{source.name}: $ #{source.install}")
  return true if dry_run

  argv = source.argv
  if argv.empty?
    bad("#{source.name}: install: is empty")
    return false
  end

  FileUtils.mkdir_p(source.staging_dir)
  # An installer with a --local flag finds "the current repo" by walking up for
  # a .git, and from inside .sources/<name> the first one it meets is this
  # checkout. Making the staging directory a repository of its own stops the
  # walk where the containment does. It costs an empty .git in a directory that
  # is already ignored, and it is why `bt setup skills --local` lands here
  # rather than in the root of whatever clone you happen to be standing in.
  Open3.capture3("git", "init", "-q", source.staging_dir) unless File.directory?(File.join(source.staging_dir, ".git"))
  stdout, stderr, status = Open3.capture3(*argv, chdir: source.staging_dir)
  return true if status.success?

  bad("#{source.name}: #{argv.first} exited #{status.exitstatus}#{said(stderr, stdout)}")
  false
rescue Errno::ENOENT
  bad("#{source.name}: #{argv.first} is not on PATH")
  false
end

# The last thing a failed command said, whichever stream it said it on. A
# command that fails is usually explaining itself on one of the two, and
# reporting only that it exited 1 wastes the explanation.
#
# @param streams [Array<String>]
# @return [String] ready to append to a message, or empty
def said(*streams)
  line = streams.filter_map { |stream| stream.to_s.lines.map(&:strip).reject(&:empty?).last }.first
  line ? " — #{line}" : ""
end

# @param source [Source]
# @param dry_run [Boolean]
# @return [Boolean] whether this source is ready to install from
def fetch(source, dry_run:)
  return run_install(source, dry_run:) if source.command?

  clone_or_update(source, dry_run:)
end

# @param dir [String]
# @return [String, nil] the commit currently checked out
def sha_of(dir)
  return nil unless repo?(dir)

  head, status = Open3.capture2("git", "-C", dir, "rev-parse", "HEAD")
  status.success? ? head.strip : nil
end

# --------------------------------------------------------------- install --

# Refuse to let an install step land on something it does not own. A skill
# folder is either a symlink this script made, or it is somebody else's —
# `skills/` held over a hundred hand-placed entries before this script
# existed, and silently replacing one is exactly the kind of "which agent
# wrote over what" failure the rest of this repo goes out of its way to avoid.
#
# `--force` is the one override, and it is exactly the override the flag
# promises: "re-installment of all key sources" means a real, un-tracked
# directory sitting where a source wants to install *is* the staleness this
# flag exists to clear, not a reason to stop.
#
# @param dest [String]
# @param owner [String] manifest key that may claim this path
# @param manifest [Hash]
# @param force [Boolean]
# @return [Boolean]
def claimable?(dest, owner, manifest, force:)
  return true unless File.exist?(dest)
  return true if File.symlink?(dest) && manifest.dig("paths", dest) == owner

  force
end

# @param source [String] absolute path to link to
# @param dest [String] absolute path of the link
# @param owner [String]
# @param manifest [Hash]
# @param dry_run [Boolean]
# @param force [Boolean]
# @return [Boolean]
def link(source, dest, owner:, manifest:, dry_run:, force: false)
  unless claimable?(dest, owner, manifest, force:)
    warn_("#{File.basename(dest)} already exists and was not put there by install-sources — left alone (pass -f to reclaim it)")
    return false
  end

  # Two different things installing under one name is not something to pick a
  # winner for. Left alone, the second overwrites the first and the run
  # reports both as installed, so what you read afterwards says you have six
  # skills when the directory holds one. Name the clash and keep the first.
  #
  # This is what a repository filing its skills as `<thing>/skills/SKILL.md`
  # rather than `<thing>/skills/<name>/SKILL.md` does to a fan-out: every one
  # of them wants to be called `skills`.
  if (prior = CLAIMED[dest]) && prior[:source] != source
    kept = prior[:source].sub("#{ROOT}/", "")
    lost = source.sub("#{ROOT}/", "")
    who = (prior[:owner] == owner) ? owner : "#{owner} and #{prior[:owner]}"
    bad("#{File.basename(dest)}: #{who} would install both #{kept} and #{lost} here — kept the first")
    return false
  end
  CLAIMED[dest] = {owner:, source:}

  INSTALLED[dest] = owner
  return true if dry_run

  already_right = File.symlink?(dest) && File.readlink(dest) == source
  FileUtils.rm_rf(dest) if (File.exist?(dest) || File.symlink?(dest)) && !already_right
  FileUtils.mkdir_p(File.dirname(dest))
  FileUtils.ln_s(source, dest) unless already_right
  manifest["paths"] ||= {}
  manifest["paths"][dest] = owner
  true
end

# Skills authored directly in this repo. Always linked, never copied — an
# edit to src/skills/foo should not need a re-run to show up.
#
# @param manifest [Hash]
# @param dry_run [Boolean]
# @return [void]
def install_mine(manifest, dry_run:, force:)
  return unless File.directory?(SRC_SKILLS_DIR)

  Dir.children(SRC_SKILLS_DIR).sort.each do |name|
    next if name.start_with?(".")

    src = File.join(SRC_SKILLS_DIR, name)
    next unless File.directory?(src)

    dest = File.join(SKILLS_DIR, name)
    if link(src, dest, owner: "src/skills", manifest:, dry_run:, force:)
      ok("skills/#{name} -> src/skills/#{name}")
    end
  end
end

# A skill is any directory with `SKILL.md` at its root — that is the actual
# boundary, not a fixed depth. `mattpocock/skills` sorts its skills one level
# deeper than that, under a category (`engineering/ask-matt`); a different
# source might not. Recursing until `SKILL.md` turns up finds a skill exactly
# where it is instead of encoding one source's layout as if it were universal.
#
# @param dir [String]
# @param depth [Integer] recursion guard — five is generous for a category tree
# @return [Array<String>] absolute paths of skill directories found
def find_skill_dirs(dir, depth: 5)
  return [] unless File.directory?(dir)
  return [dir] if File.file?(File.join(dir, "SKILL.md"))
  return [] if depth.zero?

  Dir.children(dir).sort.reject { |n| n.start_with?(".") }.flat_map { |name|
    child = File.join(dir, name)
    File.directory?(child) ? find_skill_dirs(child, depth: depth - 1) : []
  }
end

# Narrow what a source installs down to what its filter admits, and say what
# fell out. "Why is that skill missing" has to be answerable from the run that
# dropped it, otherwise a filter is just an unexplained gap in `skills/`.
#
# @param source [Source]
# @param dirs [Array<String>] every directory of that kind found in the source
# @param kind [String] "skills" or "plugins"
# @return [Array<String>] the ones the filter admits
def filter_dirs(source, dirs, kind)
  summary = source.filter_summary(kind)
  return dirs unless summary

  kept, dropped = dirs.partition { |dir| source.wants?(kind, File.basename(dir)) }
  unless dropped.empty?
    names = dropped.map { |dir| File.basename(dir) }.sort
    shown = names.first(10).join(", ")
    shown += " (+#{names.size - 10} more)" if names.size > 10
    note("#{source.name}: #{summary} skipped #{dropped.size} of #{dirs.size}: #{shown}")
  end
  kept
end

# @param source [Source]
# @param manifest [Hash]
# @param dry_run [Boolean]
# @return [Boolean] whether this source's skills were enumerated, and so can be pruned against
def install_skills_source(source, manifest, dry_run:, force:)
  unless File.directory?(source.content_dir)
    if dry_run
      note("#{source.name}: not cloned yet — would install its skills after cloning")
    else
      bad("#{source.name}: #{source.content_dir.sub("#{ROOT}/", "")} does not exist — check `path` in configuration.yml")
    end
    return false
  end

  found = find_skill_dirs(source.content_dir)
  note("#{source.name}: no SKILL.md found anywhere under #{source.path || "."}") if found.empty?

  link_skills(source, found, manifest, dry_run:, force:)
  true
end

# Every skill this run installs goes through here, whatever kind of source it
# came from, so the filter and the manifest owner cannot be applied in one
# path and forgotten in another.
#
# @param source [Source]
# @param skill_dirs [Array<String>]
# @param manifest [Hash]
# @param dry_run [Boolean]
# @param force [Boolean]
# @param label [String] what the line says the skill came from
# @return [void]
def link_skills(source, skill_dirs, manifest, dry_run:, force:, label: nil)
  filter_dirs(source, skill_dirs, "skills").each do |skill_dir|
    name = File.basename(skill_dir)
    dest = File.join(SKILLS_DIR, name)
    next unless link(skill_dir, dest, owner: source.name, manifest:, dry_run:, force:)

    ok("skills/#{name} <- #{source.name}#{" (#{label})" if label}")
  end
end

# A plugin is installed as one copy — not a symlink into `.sources`, which
# `--force` wipes — and then its own `skills/` subdirectory, if it has one,
# is fanned out the same way an external skills source is: a plugin's skills
# are still just skills, reachable without knowing which plugin they came
# from.
#
# `include_skills`/`exclude_skills` govern that fan-out, and
# `include_plugins`/`exclude_plugins` govern the copy, but neither ever
# reaches inside a bundle: it stays whole because it is one unit with its own
# manifest, and half a plugin is not a smaller plugin.

#
# @param source [Source]
# @param manifest [Hash]
# @param dry_run [Boolean]
# @return [Boolean] whether this source's skills were enumerated, and so can be pruned against
def install_plugin_source(source, manifest, dry_run:, force:)
  unless File.directory?(source.content_dir)
    if dry_run
      note("#{source.name}: not cloned yet — would install as plugins/#{source.name} after cloning")
    else
      bad("#{source.name}: #{source.content_dir.sub("#{ROOT}/", "")} does not exist — check `path` in configuration.yml")
    end
    return false
  end

  install_bundle(source.content_dir, source.name, source, manifest, dry_run:, force:)
  true
end

# One bundle, copied whole into `plugins/<name>`, and its own skills fanned
# out afterwards if this source adopts skills as well.
#
# A command source can write several bundles at once, which is why this takes
# the directory and the name rather than reading both off the source.
#
# @param bundle_dir [String] the bundle as it sits in .sources
# @param name [String] what it installs as
# @param source [Source] whose filter and manifest owner apply
# @param manifest [Hash]
# @param dry_run [Boolean]
# @param force [Boolean]
# @return [void]
def install_bundle(bundle_dir, name, source, manifest, dry_run:, force:)
  unless source.wants?("plugins", name)
    note("#{source.name}: #{source.filter_summary("plugins")} skipped plugins/#{name}")
    return
  end

  dest = File.join(PLUGINS_DIR, name)
  note("#{source.name}: installing plugin -> plugins/#{name}")
  unless dry_run
    FileUtils.rm_rf(dest)
    FileUtils.mkdir_p(File.dirname(dest))
    FileUtils.cp_r(bundle_dir, dest)
  end
  ok("plugins/#{name}")

  return unless source.adopts?("skills")

  skills_root = dry_run ? File.join(bundle_dir, "skills") : File.join(dest, "skills")
  return unless File.directory?(skills_root)

  link_skills(source, find_skill_dirs(skills_root), manifest, dry_run:, force:, label: "plugin")
end

# What a command wrote, adopted.
#
# The command has already run by the time this is called, so from here on a
# command source is an ordinary directory of skills and bundles. It is
# reconciled and pruned like any other source, which is the entire point of
# making the command run inside `.sources` rather than wherever it would
# rather write.
#
# @param source [Source]
# @param manifest [Hash]
# @param dry_run [Boolean]
# @param force [Boolean]
# @return [Boolean] whether the output was there to enumerate, and so can be pruned against
def install_command_source(source, manifest, dry_run:, force:)
  unless File.directory?(source.content_dir)
    short = source.content_dir.sub("#{ROOT}/", "")
    if dry_run
      note("#{source.name}: would install whatever the command writes into #{short}")
    else
      bad("#{source.name}: the command wrote nothing to #{short} — it may need `-g` dropped, or `path:` set")
    end
    return false
  end

  if source.adopts?("skills") && File.directory?(source.skills_root)
    link_skills(source, find_skill_dirs(source.skills_root), manifest, dry_run:, force:, label: "command")
  end

  if source.adopts?("plugins") && File.directory?(source.plugins_root)
    Dir.children(source.plugins_root).sort.reject { |n| n.start_with?(".") }.each do |name|
      bundle = File.join(source.plugins_root, name)
      install_bundle(bundle, name, source, manifest, dry_run:, force:) if File.directory?(bundle)
    end
  end

  true
end

# Take back the links this run no longer makes.
#
# A filter that only ever adds is not a filter: tighten `exclude_skills` and
# the skill you just excluded would sit in `skills/` forever, still linked,
# still loaded, with nothing left to say why. The same goes for a skill an
# upstream repo has since deleted or renamed.
#
# Only owners this run actually enumerated are pruned, and only links the
# manifest already claimed, so a source whose clone failed on a network blip
# keeps its skills instead of losing them.
#
# The same link under the same name, spelled the way this run spells it. A
# manifest written before ROOT was resolved holds the other spelling, and
# unlinking one of those would take the link this run had just made.
#
# @param path [String]
# @return [String]
def canonical(path)
  File.join(File.realpath(File.dirname(path)), File.basename(path))
rescue Errno::ENOENT
  path
end

# @param previous [Hash] dest => owner, as of the last run
# @param manifest [Hash] the manifest about to be saved
# @param reconciled [Array<String>] owners this run enumerated in full
# @param dry_run [Boolean]
# @return [void]
def prune_stale(previous, manifest, reconciled, dry_run:)
  stale = previous.select { |dest, owner|
    reconciled.include?(owner) && !INSTALLED.key?(dest) && !INSTALLED.key?(canonical(dest))
  }
  return if stale.empty?

  say("")
  say(paint("no longer installed", 1))
  stale.each do |dest, owner|
    short = dest.sub("#{ROOT}/", "")
    if File.symlink?(dest)
      note("#{short}: dropped by #{owner}")
      FileUtils.rm_f(dest) unless dry_run
    elsif File.exist?(dest)
      warn_("#{short} is no longer installed by #{owner} but is not a symlink — left alone")
    end
    manifest["paths"]&.delete(dest) unless dry_run
  end
end

# ---------------------------------------------------------------- verbs --

# @param source [Source]
# @return [String] where this source comes from, as the listing says it
def origin_of(source) = source.command? ? "$ #{source.install}" : source.repo.to_s

# @param source [Source]
# @return [String] how far along it is. A cloned repo can say which commit it
#   is on; a command can only say whether it has left anything behind.
def state_of(source)
  return File.directory?(source.content_dir) ? "installed" : "not run" if source.command?

  sha_of(source.staging_dir)&.slice(0, 8) || "not cloned"
end

def cmd_list
  sources = load_sources
  manifest = load_manifest

  say(paint("Configured sources", 1))
  if sources.empty?
    note("none — add one to #{CONFIG_FILE.sub("#{ROOT}/", "")}")
  else
    sources.each do |s|
      say("  #{s.name.ljust(14)} #{s.type.ljust(7)} #{origin_of(s)}  [#{state_of(s)}]")
      s.filter_summaries.each { |summary| say("  #{" ".ljust(14)} #{paint(summary, 2)}") }
      say("  #{" ".ljust(14)} #{paint(s.adopt_summary, 2)}") if s.adopt_summary
    end
  end

  say("")
  say(paint("Installed, by owner", 1))
  owners = (manifest["paths"] || {}).values.tally
  if owners.empty?
    note("nothing installed yet — run without arguments first")
  else
    owners.sort.each { |owner, count| say("  #{owner.ljust(14)} #{count}") }
  end
end

def cmd_install(force:, dry_run:)
  # Read the config before anything is written. A configuration.yml this script
  # refuses should not first cost you a `.sources` wipe or an empty `skills/`.
  sources = load_sources

  say(paint("Installing sources into #{ROOT}", 1))
  say(paint("dry run — nothing will be written", 33)) if dry_run
  say("")

  if force
    say(paint("--force: wiping .sources for a clean re-clone", 33))
    FileUtils.rm_rf(STAGING_DIR) unless dry_run
  end

  # The previous manifest is read even under --force, which starts the new one
  # empty: forgetting what was installed is not the same as unlinking it, and
  # only the old record knows which of today's leftovers this script put there.
  previous = load_manifest["paths"] || {}
  manifest = force ? {} : load_manifest
  FileUtils.mkdir_p(SKILLS_DIR) unless dry_run
  FileUtils.mkdir_p(PLUGINS_DIR) unless dry_run

  say(paint("src/skills", 1))
  install_mine(manifest, dry_run:, force:)
  reconciled = File.directory?(SRC_SKILLS_DIR) ? ["src/skills"] : []

  sources.each do |source|
    say("")
    say(paint(source.name, 1))

    if known_agents.any? && !source.for_any?(known_agents)
      note(source.targeting_note)
      # Counted as reconciled, so whatever it installed last time is pruned.
      # Being for nobody here is a decision, and skills/ converges on what the
      # configuration says. A source that simply could not be fetched takes the
      # `next` below instead and keeps its links, because a network that was
      # down is not an instruction to uninstall anything.
      reconciled << source.name
      next
    end

    next unless fetch(source, dry_run:)

    enumerated = case source.type
    when "skills" then install_skills_source(source, manifest, dry_run:, force:)
    when "plugin" then install_plugin_source(source, manifest, dry_run:, force:)
    when "command" then install_command_source(source, manifest, dry_run:, force:)
    else
      bad("#{source.name}: unknown type #{source.type.inspect} — expected skills, plugin or command")
      false
    end
    reconciled << source.name if enumerated
  end

  prune_stale(previous, manifest, reconciled, dry_run:)
  save_manifest(manifest) unless dry_run
  say("")
  say(paint("Done.", 1) + " `scripts/install-sources list` to see what's installed from where.")
end

# ---------------------------------------------------------------- agents --

# A coding agent this machine should have, and the vendor's own line for
# getting it. `installer` is optional: an agent can be listed purely to say
# "this machine has one of these", which is all a source's `agents:` needs in
# order to decide whether its skills have a reader.
Agent = Struct.new(:name, :installer) do
  # Looked up on PATH rather than with `which`, so the answer does not depend
  # on a shell being present or on how it was configured.
  #
  # @return [String, nil] the executable found, or nil
  def on_path
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |dir|
      candidate = File.join(dir, name)
      return candidate if File.file?(candidate) && File.executable?(candidate)
    end
    nil
  end

  def installed? = !on_path.nil?
end

# @return [Array<Agent>]
def load_agents
  (config["agents"] || []).map do |h|
    raise ConfigError, "an entry under agents: has no name" if h["name"].to_s.strip.empty?
    reject_unknown_keys(h, AGENT_KEYS, "#{h["name"]}: keys nothing reads")

    # Absent is fine; present and not a usable command line is not.
    installer = h["installer"]
    usable = installer.nil? || (installer.is_a?(String) && !installer.strip.empty?)
    raise ConfigError, "#{h["name"]}: installer: must be a command line, got #{installer.inspect}" unless usable

    Agent.new(h["name"].to_s, installer)
  end
end

# Every agent named anywhere this run will consider a reader: installed on
# this machine, or listed in the configuration as one this machine should
# have. A source aimed at anything outside this set has nobody to install for.
#
# @return [Array<String>]
# Memoised: every source consults it, and it is a property of the run.
#
# Empty means the configuration has no `agents:` block at all, and targeting
# is then inert rather than exclusive — a file written before this existed
# should not suddenly install nothing.
def known_agents = @known_agents ||= load_agents.map(&:name)

def cmd_agents(args, dry_run:)
  agents = load_agents
  if agents.empty?
    say("")
    note("no agents: block in #{CONFIG_FILE.sub("#{ROOT}/", "")}")
    return
  end

  installing = args.first == "install"
  wanted = args.drop(1)
  unless wanted.empty?
    unknown = wanted - agents.map(&:name)
    raise ConfigError, "not listed under agents: #{unknown.join(", ")}" unless unknown.empty?
  end

  say("")
  say(paint("agents", 1))
  agents.each do |agent|
    next unless wanted.empty? || wanted.include?(agent.name)

    if agent.installed?
      ok("#{agent.name} #{paint(agent.on_path, 2)}")
      next
    end

    unless agent.installer
      note("#{agent.name} not installed, and no installer: to run")
      next
    end

    unless installing
      note("#{agent.name} not installed — `agents install #{agent.name}` runs: #{agent.installer}")
      next
    end

    if dry_run
      note("#{agent.name} would run: #{agent.installer}")
      next
    end

    # Through a shell, unlike a source's `install:`. A vendor's install line
    # is a pipeline and is meant to be one; what makes that acceptable here
    # and not there is that this runs only when somebody asked for this agent
    # by name, never as part of a routine sync.
    say("  #{paint("·", 2)} #{agent.name}: #{agent.installer}")
    if system(agent.installer)
      ok("#{agent.name} installed")
    else
      bad("#{agent.name}: installer exited #{$?.exitstatus}")
    end
  end
end

# ------------------------------------------------------------------- cli --

def usage
  puts <<~USAGE
    install-sources — pull external skills and plugins into this repo

      scripts/install-sources              clone what's missing, update the rest
      scripts/install-sources --dry-run    say what it would do, touch nothing
      scripts/install-sources -f           wipe .sources and re-clone everything
      scripts/install-sources list         what's configured, and what's installed
      scripts/install-sources agents       which coding agents are configured, and installed
      scripts/install-sources agents install [name...]   install the ones that are missing

    A source in configuration.yml may narrow itself with `include_skills: /re/`
    or `exclude_skills: /re/`, one or the other, matched against the name each
    skill would install as.

    A `type: command` source runs `install:` inside .sources/<name> instead of
    cloning, then installs the skills and plugin bundles it wrote there.
    `adopt: [skills, plugins]` narrows which of the two it contributes.
  USAGE
end

args = ARGV.dup
if args.delete("-h") || args.delete("--help")
  usage
  exit 0
end

force = !!(args.delete("-f") || args.delete("--force"))
dry_run = !!(args.delete("-n") || args.delete("--dry-run"))
verb = args.shift || "install"

begin
  case verb
  when "install" then cmd_install(force:, dry_run:) if ensure_configuration
  when "list" then cmd_list if ensure_configuration
  when "agents" then cmd_agents(args, dry_run:) if ensure_configuration
  else
    out("install-sources: unknown command #{verb.inspect}\n")
    usage
    exit 64
  end
rescue ConfigError => e
  bad("configuration.yml: #{e.message}")
  exit 78
end
