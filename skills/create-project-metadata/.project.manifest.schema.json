{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kig.re/schemas/project-1.0.0.json",
  "title": "Project Manifest",
  "description": "Technology-independent project metadata. Field names follow CodeMeta / schema.org where an equivalent exists; 'stack', 'conventions', and 'generated' are local extensions.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "identifier",
    "name",
    "description",
    "version",
    "developmentStatus",
    "license",
    "codeRepository"
  ],

  "properties": {
    "$schema": { "type": "string" },

    "schemaVersion": {
      "description": "Version of THIS manifest format, so consumers can detect breaking changes.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "identifier": {
      "description": "Stable machine-readable slug. Must match the repository directory name.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "maxLength": 64
    },

    "name": {
      "description": "Human-readable display name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },

    "description": {
      "description": "One sentence. If it needs two, it belongs in the README.",
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },

    "version": {
      "description": "SemVer. Derived - see 'generated'. Do not hand-edit.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
    },

    "developmentStatus": {
      "description": "repostatus.org vocabulary.",
      "enum": [
        "concept",
        "wip",
        "suspended",
        "abandoned",
        "active",
        "inactive",
        "unsupported",
        "moved"
      ]
    },

    "license": {
      "description": "SPDX license identifier, or 'UNLICENSED' for private code.",
      "type": "string",
      "pattern": "^(UNLICENSED|[A-Za-z0-9.+-]+(?: (?:AND|OR|WITH) [A-Za-z0-9.+-]+)*)$"
    },

    "codeRepository": { "type": "string", "format": "uri" },
    "url": { "type": "string", "format": "uri" },
    "issueTracker": { "type": "string", "format": "uri" },

    "author": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "format": "email" },
          "url": { "type": "string", "format": "uri" },
          "orcid": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" }
        }
      }
    },

    "programmingLanguage": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },

    "runtimePlatform": { "type": "array", "items": { "type": "string" } },

    "applicationCategory": {
      "description": "schema.org applicationCategory. Free text, but stay consistent across repos.",
      "type": "string"
    },

    "keywords": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true,
      "maxItems": 12
    },

    "stack": {
      "description": "Local extension. What it is built with, for tooling and dashboards.",
      "type": "object",
      "additionalProperties": false,
      "required": ["language"],
      "properties": {
        "language": { "type": "string", "pattern": "^[a-z0-9+#-]+$" },
        "languageVersion": { "type": "string" },
        "packageManager": { "type": "string" },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "datastores": { "type": "array", "items": { "type": "string" } },
        "testing": { "type": "array", "items": { "type": "string" } },
        "linting": { "type": "array", "items": { "type": "string" } },
        "ci": { "type": "string" },
        "deploy": { "type": "string" }
      }
    },

    "conventions": {
      "description": "Local extension. Where the spec-driven workflow lives and how PRs link back to specs.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specsPath": { "type": "string" },
        "specIdPattern": {
          "description": "Regex in the HOST language's dialect (Ruby here), NOT ECMA-262. Deliberately not format:regex - named groups differ across engines.",
          "type": "string"
        },
        "branchPattern": {
          "description": "Regex in the HOST language's dialect (Ruby here). Must expose a named group matching 'commitScopeField' so tooling can extract the spec ID from a branch name.",
          "type": "string"
        },
        "commitScopeField": { "type": "string" },
        "specArtifacts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.md$" },
          "uniqueItems": true
        }
      }
    },

    "generated": {
      "description": "Local extension. Maps field name -> the authority that owns it. Any field listed here is overwritten by tooling; hand-edits will be reverted.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },

    "dateCreated": { "type": "string", "format": "date" },
    "dateModified": { "type": "string", "format": "date" }
  }
}
