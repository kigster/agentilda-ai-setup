**/.DS_Store
**/settings.local.json
coverage/
.rspec_status
tmp/
.idea/

# Developer secrets. Encrypted to .env.encrypted via sopsy; the plaintext never lands in git.
.env
.rubymate/

# Regenerated by scripts/install-sources from configuration.yml +
# src/skills/ (which IS committed). Not committed here so a stale download
# can't outlive the source it came from -- `install-sources -f` rebuilds both
# from scratch. Currently-tracked entries under skills/ are cleanup debt from
# before this script existed; `git rm -r --cached skills/` retires them
# deliberately rather than here, so that removal shows up as its own commit.
/plugins/*
/skills/*
.sources/

# Bundler installs here when BUNDLE_PATH is set locally. Never committed.
vendor/bundle/

# Built by `gem build`. The gem is assembled from the checkout, not stored in it.
*.gem

# Per-machine, seeded from configuration.example.yml on a first run. Which
# skills and which agents a machine should have is a property of the machine.
/configuration.yml
